  "notes": "20-item bank. CAPS mix: 8 L2 / 8 L3 / 4 L4. Distance ÷ speed = time. Account for stops, refuelling. Time zones for international.",
  "items": [
    {"id": "L6.T3.A3.q01","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Distance ÷ speed = time."},"question": "Drive 240 km at 80 km/h. Time?","answerMode": "numeric","expectedAnswer": 3,"tolerance": 0.05,"unit": "hours","workingSteps": ["240 ÷ 80 = 3 h."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q02","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Time = distance ÷ speed."},"question": "Drive 450 km at 90 km/h. Time?","answerMode": "numeric","expectedAnswer": 5,"tolerance": 0.05,"unit": "hours","workingSteps": ["450 ÷ 90 = 5 h."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q03","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Distance = speed × time."},"question": "Drive 100 km/h for 3,5 hours. Distance?","answerMode": "numeric","expectedAnswer": 350,"tolerance": 1,"unit": "km","workingSteps": ["100 × 3,5 = 350 km."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q04","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Speed = distance ÷ time."},"question": "Drive 180 km in 2 h. Avg speed?","answerMode": "numeric","expectedAnswer": 90,"tolerance": 1,"unit": "km/h","workingSteps": ["180 ÷ 2 = 90 km/h."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q05","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Trip with rest stop."},"question": "Drive 320 km at 80 km/h then take a 30-min stop. Total trip time?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 4, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 30, "tolerance": 1}],"workingSteps": ["Drive: 320 ÷ 80 = 4 h. Stop: 30 min. Total: 4 h 30 min."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q06","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Petrol consumption rate. 8 L/100 km, trip 600 km."},"question": "Litres needed?","answerMode": "numeric","expectedAnswer": 48,"tolerance": 1,"unit": "L","workingSteps": ["600 ÷ 100 × 8 = 48 L."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q07","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Petrol cost. 48 L at R23,50/L."},"question": "Fuel cost?","answerMode": "numeric","expectedAnswer": 1128,"tolerance": 5,"unit": "R","workingSteps": ["48 × R23,50 = R1 128."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q08","skill": "L6.T3.A3","caps_level": 2,"source": "fresh","stimulus": {"inline": "Departure plan. Need to arrive by 14:00; trip takes 3 h 30 min."},"question": "Latest departure time?","answerMode": "multiChoice","options": ["10:00", "10:30", "11:00", "11:30"],"expectedAnswer": "10:30","workingSteps": ["14:00 − 3:30 = 10:30."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q09","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "JNB → CPT 1 400 km drive at avg 100 km/h. One 30-min lunch break."},"question": "Total trip time?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 14, "tolerance": 0.5}, {"label": "Minutes", "expectedAnswer": 30, "tolerance": 1}],"workingSteps": ["Drive: 1 400 ÷ 100 = 14 h. Stop: 30 min. Total: 14 h 30 min."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q10","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "Trip 600 km at 100 km/h. Fuel 8 L/100 km @ R23,50/L. Two stops 20 min each, two refuelling 10 min each."},"question": "Total time and total fuel cost.","answerMode": "multiField","fields": [{"label": "Total time (hours, decimal)", "expectedAnswer": 7, "tolerance": 0.2}, {"label": "Fuel cost (R)", "expectedAnswer": 1128, "tolerance": 5}],"workingSteps": ["Drive: 6 h. Stops: 40 min + 20 min = 60 min = 1 h. Total: 7 h.", "Fuel: 48 L × R23,50 = R1 128."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE","ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q11","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "Convert km/h to m/s. ÷ 3,6."},"question": "Convert 90 km/h to m/s.","answerMode": "numeric","expectedAnswer": 25,"tolerance": 1,"unit": "m/s","workingSteps": ["90 ÷ 3,6 = 25 m/s."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q12","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "Plan a trip on a tight schedule. Need to arrive Cape Town by 18:00 from Worcester (110 km away) driving at 90 km/h."},"question": "Latest departure time?","answerMode": "multiChoice","options": ["16:45", "16:50", "16:30", "17:00"],"expectedAnswer": "16:45","workingSteps": ["Time = 110 ÷ 90 ≈ 1,22 h ≈ 73 min. 18:00 − 73 min ≈ 16:47.","Closest option: 16:45 (slight buffer)."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE","ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q13","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "Avg speed across two segments. 100 km at 100 km/h then 100 km at 50 km/h. Total distance 200 km."},"question": "Avg speed for entire trip?","answerMode": "numeric","expectedAnswer": 66.7,"tolerance": 2,"unit": "km/h","workingSteps": ["Time = 1 + 2 = 3 h. Avg = 200 ÷ 3 ≈ 66,7 km/h.","(Note: NOT (100+50)/2 = 75.)"],"errorSignals": ["ERR_AVG_SPEED"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q14","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "Fuel range. 50 L tank, 8 L/100 km."},"question": "Maximum range without refuelling?","answerMode": "numeric","expectedAnswer": 625,"tolerance": 5,"unit": "km","workingSteps": ["50 ÷ 8 × 100 = 625 km."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q15","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "Plan stops. 1 400 km trip, fuel range 625 km."},"question": "Minimum number of refuel stops needed (must reach destination)?","answerMode": "numeric","expectedAnswer": 2,"tolerance": 0.5,"unit": "stops","workingSteps": ["1 400 ÷ 625 ≈ 2,24 → 2 refuel stops (then drive the rest on third tank)."],"errorSignals": ["ERR_ROUND_DIRECTION_CONTEXT"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q16","skill": "L6.T3.A3","caps_level": 3,"source": "fresh","stimulus": {"inline": "Compare two routes: Route A 450 km at 90 km/h. Route B 380 km at 70 km/h (less highway)."},"question": "Which route takes LESS time and by how much in minutes?","answerMode": "multiField","fields": [{"label": "Faster route", "expectedAnswer": "A"}, {"label": "Time saved (min)", "expectedAnswer": 26, "tolerance": 5}],"workingSteps": ["A: 450 ÷ 90 = 5 h = 300 min.", "B: 380 ÷ 70 ≈ 5,43 h ≈ 326 min.", "A is faster by ~26 min."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE","ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q17","skill": "L6.T3.A3","caps_level": 4,"source": "fresh","stimulus": {"inline": "Time zones. Flight Cape Town → Dubai, depart CPT 23:30. Flight duration 9 h. Dubai is GMT+4, SA is GMT+2."},"question": "Local arrival time in Dubai?","answerMode": "multiChoice","options": ["08:30", "10:30", "11:30", "12:30"],"expectedAnswer": "10:30","workingSteps": ["Depart 23:30 SA time. Add 9 h = 08:30 SA time arrival. Dubai is +2 h → 10:30 local."],"errorSignals": ["ERR_TIMEZONE","ERR_TIME_DURATION_MIDNIGHT"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q18","skill": "L6.T3.A3","caps_level": 4,"source": "fresh","stimulus": {"inline": "Long road trip with two refuelling stops 30 min each + lunch 1 h. Drive 1 600 km at avg 110 km/h."},"question": "Total clock time on the road?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 16, "tolerance": 0.5}, {"label": "Minutes", "expectedAnswer": 30, "tolerance": 5}],"workingSteps": ["Drive time = 1 600 ÷ 110 ≈ 14,55 h ≈ 14 h 33 min.", "Stops: 30 + 30 + 60 = 120 min = 2 h.", "Total ≈ 16 h 33 min."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE","ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q19","skill": "L6.T3.A3","caps_level": 4,"source": "fresh","stimulus": {"inline": "Avg speed including stop time. Drove 240 km in 4 h CLOCK time (including a 30-min stop)."},"question": "Avg speed CLOCK time?","answerMode": "numeric","expectedAnswer": 60,"tolerance": 1,"unit": "km/h","workingSteps": ["240 ÷ 4 = 60 km/h."],"errorSignals": ["ERR_AVG_SPEED"],"passThreshold": 0.85},
    {"id": "L6.T3.A3.q20","skill": "L6.T3.A3","caps_level": 4,"source": "fresh","stimulus": {"inline": "From the previous: avg DRIVE speed (excluding 30-min stop)."},"question": "Avg drive speed?","answerMode": "numeric","expectedAnswer": 68.6,"tolerance": 2,"unit": "km/h","workingSteps": ["Drive time = 4 h − 0,5 h = 3,5 h.", "Speed = 240 ÷ 3,5 ≈ 68,57 km/h ≈ 68,6."],"errorSignals": ["ERR_AVG_SPEED"],"passThreshold": 0.85}
  ],
