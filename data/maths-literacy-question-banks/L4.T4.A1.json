  "_error_signal_vocabulary": {
    "ERR_COMPOUND_AS_SIMPLE": "Calculates compound interest as simple interest (i.e. interest only on original principal each period)",
    "ERR_BALANCE_GROWTH_BASE": "Calculates each period's interest on the wrong balance (typically the original P instead of the current/growing balance)",
    "ERR_PERCENT_TO_DECIMAL": "Uses interest rate as percentage instead of decimal",
    "ERR_TOTAL_VS_INTEREST": "Reports total amount when asked for interest only, or vice versa",
    "ERR_COMPOUND_FREQUENCY": "Confuses compounding frequency (e.g. uses annual rate with annual compounding when monthly compounding is required)"
  }
