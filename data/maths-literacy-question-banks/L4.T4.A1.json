    {"id": "L4.T4.A1.q13", "skill": "L4.T4.A1", "caps_level": 3, "source": "fresh", "stimulus": {"inline": "**Compound interest period-by-period.**"}, "question": "R30 000 at 9% p.a. compound. Use the table method to find the balance at end of year 5. (Compute year by year, don't use the formula.)", "answerMode": "numeric", "expectedAnswer": 46159.93, "tolerance": 5, "unit": "R", "workingSteps": ["Y1: 30 000 × 1,09 = R32 700.", "Y2: 32 700 × 1,09 = R35 643.", "Y3: 35 643 × 1,09 = R38 850,87.", "Y4: 38 850,87 × 1,09 ≈ R42 347,45.", "Y5: 42 347,45 × 1,09 ≈ R46 158,72.", "Verify with formula: 30 000 × (1,09)^5 ≈ R46 159,93."], "errorSignals": ["ERR_BALANCE_GROWTH_BASE", "ERR_COMPOUND_AS_SIMPLE"], "passThreshold": 0.85},
