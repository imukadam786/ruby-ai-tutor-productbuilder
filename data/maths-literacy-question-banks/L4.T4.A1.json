    {"id": "L4.T4.A1.q07", "skill": "L4.T4.A1", "caps_level": 2, "source": "fresh", "stimulus": {"inline": "**A = P(1 + i)^n.**"}, "question": "Mpho's R2 000 savings at 5% p.a. compound. What is the total amount after 4 years?", "answerMode": "numeric", "expectedAnswer": 2431.01, "tolerance": 1, "unit": "R", "workingSteps": ["A = 2 000 × (1,05)^4 = 2 000 × 1,21551 ≈ R2 431,01."], "errorSignals": ["ERR_COMPOUND_AS_SIMPLE"], "passThreshold": 0.85},
