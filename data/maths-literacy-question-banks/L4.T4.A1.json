  "items": [
    {"id": "L4.T4.A1.q01", "skill": "L4.T4.A1", "caps_level": 2, "source": "fresh", "stimulus": {"inline": "**Compound interest formula:** A = P(1 + i)^n. Each period, interest is earned on the CURRENT balance (which already includes prior interest)."}, "question": "Thandi deposits R5 000 at 8% per annum compound interest. Calculate the balance at the end of year 1.", "answerMode": "numeric", "expectedAnswer": 5400, "tolerance": 0.5, "unit": "R", "workingSteps": ["Year 1 interest: R5 000 × 0,08 = R400.", "Closing balance: R5 000 + R400 = R5 400."], "errorSignals": ["ERR_COMPOUND_AS_SIMPLE", "ERR_PERCENT_TO_DECIMAL"], "passThreshold": 0.85},
    {"id": "L4.T4.A1.q02", "skill": "L4.T4.A1", "caps_level": 2, "source": "fresh", "stimulus": {"inline": "**Compound interest:** A = P(1 + i)^n."}, "question": "Continuing Thandi's R5 000 @ 8% p.a. compound. Calculate the balance at end of year 2.", "answerMode": "numeric", "expectedAnswer": 5832, "tolerance": 0.5, "unit": "R", "workingSteps": ["Year 1 closing balance: R5 400 (from previous).", "Year 2 interest: R5 400 × 0,08 = R432.", "Year 2 closing: R5 400 + R432 = R5 832."], "errorSignals": ["ERR_COMPOUND_AS_SIMPLE", "ERR_BALANCE_GROWTH_BASE"], "passThreshold": 0.85},
    {"id": "L4.T4.A1.q03", "skill": "L4.T4.A1", "caps_level": 3, "source": "fresh", "stimulus": {"inline": "**Compound interest:** A = P(1 + i)^n."}, "question": "Thandi's R5 000 @ 8% compound. Complete the period-by-period table for years 1-3.", "answerMode": "multiField", "fields": [{"label": "Year 1 closing (R)", "expectedAnswer": 5400, "tolerance": 0.5}, {"label": "Year 2 closing (R)", "expectedAnswer": 5832, "tolerance": 0.5}, {"label": "Year 3 closing (R)", "expectedAnswer": 6298.56, "tolerance": 0.5}], "workingSteps": ["Year 1: R5 000 × 1,08 = R5 400.", "Year 2: R5 400 × 1,08 = R5 832.", "Year 3: R5 832 × 1,08 = R6 298,56."], "errorSignals": ["ERR_COMPOUND_AS_SIMPLE", "ERR_BALANCE_GROWTH_BASE"], "passThreshold": 0.85},
    {"id": "L4.T4.A1.q04", "skill": "L4.T4.A1", "caps_level": 2, "source": "fresh", "stimulus": {"inline": "**A = P(1 + i)^n.**"}, "question": "Calculate the total amount on R20 000 at 7,5% per annum compound interest for 3 years.", "answerMode": "numeric", "expectedAnswer": 24840.94, "tolerance": 1, "unit": "R", "workingSteps": ["A = 20 000 × (1,075)^3 = 20 000 × 1,2423... = R24 840,94."], "errorSignals": ["ERR_COMPOUND_AS_SIMPLE", "ERR_PERCENT_TO_DECIMAL"], "passThreshold": 0.85},
