    {"id": "L4.T4.A1.q09", "skill": "L4.T4.A1", "caps_level": 3, "source": "fresh", "stimulus": {"inline": "**Naledi puts R8 000 into a savings account at 6,5% p.a. compound for 5 years.**"}, "question": "Find the total interest earned (NOT the total amount).", "answerMode": "numeric", "expectedAnswer": 2961.13, "tolerance": 1, "unit": "R", "workingSteps": ["A = 8 000 × (1,065)^5 = 8 000 × 1,37008... ≈ R10 961,13.", "Interest = A − P = R10 961,13 − R8 000 = R2 961,13."], "errorSignals": ["ERR_TOTAL_VS_INTEREST", "ERR_COMPOUND_AS_SIMPLE"], "passThreshold": 0.85},
