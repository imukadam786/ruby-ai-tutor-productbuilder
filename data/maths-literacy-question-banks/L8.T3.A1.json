  "version": "1.0",
  "notes": "20-item bank. CAPS mix: 5 L1 / 8 L2 / 7 L3. Identify rooms, dimensions, doors, windows. Recognise scale. Match floor plan to elevations.",
  "items": [
    {"id": "L8.T3.A1.q01","skill": "L8.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "**Floor plan** (scale 1:50): Kitchen 3 m × 4 m, Lounge 5 m × 4 m, two Bedrooms 3,5 m × 3 m each, Bathroom 2 m × 2 m."},"question": "Kitchen dimensions?","answerMode": "multiField","fields": [{"label": "L (m)", "expectedAnswer": 3, "tolerance": 0.1}, {"label": "W (m)", "expectedAnswer": 4, "tolerance": 0.1}],"workingSteps": ["Read kitchen: 3 m × 4 m."],"errorSignals": ["ERR_DOCUMENT_FIELD"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q02","skill": "L8.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same plan."},"question": "Lounge area m²?","answerMode": "numeric","expectedAnswer": 20,"tolerance": 0.5,"unit": "m²","workingSteps": ["5 × 4 = 20 m²."],"errorSignals": ["ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q03","skill": "L8.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same plan."},"question": "Bathroom area?","answerMode": "numeric","expectedAnswer": 4,"tolerance": 0.5,"unit": "m²","workingSteps": ["2 × 2 = 4 m²."],"errorSignals": ["ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q04","skill": "L8.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Plan scale 1:50. Kitchen 3 m wide."},"question": "Kitchen width on plan (cm)?","answerMode": "numeric","expectedAnswer": 6,"tolerance": 0.5,"unit": "cm","workingSteps": ["3 m = 300 cm ÷ 50 = 6 cm."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q05","skill": "L8.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Plan key: door = arc, window = double parallel lines."},"question": "What does a double-line symbol indicate?","answerMode": "multiChoice","options": ["door", "window", "wall", "stair"],"expectedAnswer": "window","workingSteps": ["Read key."],"errorSignals": ["ERR_MAP_KEY"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q06","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same plan with kitchen, lounge, 2 bedrooms (3,5×3 each), bathroom."},"question": "Total bedroom area?","answerMode": "numeric","expectedAnswer": 21,"tolerance": 0.5,"unit": "m²","workingSteps": ["2 × (3,5 × 3) = 2 × 10,5 = 21 m²."],"errorSignals": ["ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q07","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Total floor area = sum of all rooms (ignore walls)."},"question": "Total floor area?","answerMode": "numeric","expectedAnswer": 57,"tolerance": 1,"unit": "m²","workingSteps": ["Kitchen 12 + Lounge 20 + 2 Bedrooms 21 + Bathroom 4 = 57 m²."],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q08","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Elevation plan — North elevation shows the wall facing N (looking at the house from N)."},"question": "If you stand N of house and look S, you see:","answerMode": "multiChoice","options": ["South elevation", "North elevation", "East elevation", "West elevation"],"expectedAnswer": "North elevation","workingSteps": ["The N elevation is the wall facing N — visible from north."],"errorSignals": ["ERR_ELEVATION_VIEW"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q09","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Plan scale 1:100. Lounge 5 cm × 4 cm on plan."},"question": "Real dimensions m?","answerMode": "multiField","fields": [{"label": "L (m)", "expectedAnswer": 5, "tolerance": 0.1}, {"label": "W (m)", "expectedAnswer": 4, "tolerance": 0.1}],"workingSteps": ["5 cm × 100 = 500 cm = 5 m; 4 cm = 4 m."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q10","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Bedroom door width 800 mm. A king bed 2 m × 1,8 m needs to fit through."},"question": "Will the bed fit through (yes/no)?","answerMode": "multiChoice","options": ["Yes — short side 1,8 m < door width 0,8 m", "No — bed too wide", "Yes — turned sideways", "Cannot tell"],"expectedAnswer": "No — bed too wide","workingSteps": ["Bed narrowest dimension 1,8 m = 1 800 mm > 800 mm door. Won't fit."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q11","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Floor plan above. Kitchen door 900 mm wide."},"question": "Door width in m?","answerMode": "numeric","expectedAnswer": 0.9,"tolerance": 0.05,"unit": "m","workingSteps": ["900 mm = 0,9 m."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q12","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Elevation plan: West shows pitched roof, big window, door."},"question": "Looking from W, you see W elevation. Number of windows shown is 1.","answerMode": "numeric","expectedAnswer": 1,"tolerance": 0,"unit": "windows","workingSteps": ["1 big window shown on the W elevation."],"errorSignals": ["ERR_ELEVATION_VIEW"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q13","skill": "L8.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Scale 1:100. Plan distance kitchen-to-bathroom (along corridor) = 12 cm."},"question": "Real distance m?","answerMode": "numeric","expectedAnswer": 12,"tolerance": 0.5,"unit": "m","workingSteps": ["12 × 100 = 1 200 cm = 12 m."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q14","skill": "L8.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Carpet for lounge 5×4 m at R220/m²."},"question": "Carpet cost?","answerMode": "numeric","expectedAnswer": 4400,"tolerance": 10,"unit": "R","workingSteps": ["Area: 20 m². Cost: 20 × R220 = R4 400."],"errorSignals": ["ERR_AREA_FORMULA","ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q15","skill": "L8.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Bathroom tile 2×2 m. Tile 25 cm × 25 cm."},"question": "Tiles needed (no waste)?","answerMode": "numeric","expectedAnswer": 64,"tolerance": 2,"unit": "tiles","workingSteps": ["Area: 4 m² = 40 000 cm². Tile area: 625 cm². 40 000 ÷ 625 = 64."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION","ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q16","skill": "L8.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Floor plan shows total area 80 m². Carpet R250/m²."},"question": "Cost?","answerMode": "numeric","expectedAnswer": 20000,"tolerance": 50,"unit": "R","workingSteps": ["80 × R250 = R20 000."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q17","skill": "L8.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Elevation plan: N elevation shows 2 windows + 1 door; S elevation shows 1 window + 1 door; E shows 1 window; W shows 1 window."},"question": "Total windows shown across all elevations?","answerMode": "numeric","expectedAnswer": 5,"tolerance": 0.5,"unit": "windows","workingSteps": ["2+1+1+1 = 5 windows."],"errorSignals": ["ERR_ELEVATION_VIEW","ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q18","skill": "L8.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Same total. Doors?"},"question": "Total doors?","answerMode": "numeric","expectedAnswer": 2,"tolerance": 0.5,"unit": "doors","workingSteps": ["1+1+0+0 = 2 doors."],"errorSignals": ["ERR_ELEVATION_VIEW"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q19","skill": "L8.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Plan 1:50; lounge 5 m wide. Plan width in cm?"},"question": "Plan width cm?","answerMode": "numeric","expectedAnswer": 10,"tolerance": 0.5,"unit": "cm","workingSteps": ["5 m ÷ 50 × 100 = 10 cm."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T3.A1.q20","skill": "L8.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Site plan with scale 1:200 shows house footprint 18 cm × 14 cm."},"question": "Real footprint area m²?","answerMode": "numeric","expectedAnswer": 1008,"tolerance": 50,"unit": "m²","workingSteps": ["18 × 200 = 3 600 cm = 36 m. 14 × 200 = 28 m. Area = 36 × 28 = 1 008 m²."],"errorSignals": ["ERR_SCALE_DIRECTION","ERR_AREA_FORMULA"],"passThreshold": 0.85}
  ],
