    {"id": "L8.T1.A1.q17","skill": "L8.T1.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Plan 1:50. Kitchen 6 cm wide on plan."},"question": "Real width m?","answerMode": "numeric","expectedAnswer": 3,"tolerance": 0.1,"unit": "m","workingSteps": ["6 × 50 = 300 cm = 3 m."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q18","skill": "L8.T1.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Bar scale 5 cm = 50 km."},"question": "What is the equivalent ratio scale?","answerMode": "multiChoice","options": ["1:10", "1:100", "1:10 000", "1:1 000 000"],"expectedAnswer": "1:1 000 000","workingSteps": ["1 cm = 10 km = 1 000 000 cm. Ratio 1:1 000 000."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q19","skill": "L8.T1.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Site plan 1:200. Tree plotted 25 cm from house."},"question": "Real distance m?","answerMode": "numeric","expectedAnswer": 50,"tolerance": 1,"unit": "m","workingSteps": ["25 × 200 = 5 000 cm = 50 m."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q20","skill": "L8.T1.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Real road 12 km, want to put on a 1:30 000 map."},"question": "Map length cm?","answerMode": "numeric","expectedAnswer": 40,"tolerance": 1,"unit": "cm","workingSteps": ["12 km = 1 200 000 cm ÷ 30 000 = 40 cm."],"errorSignals": ["ERR_SCALE_DIRECTION","ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85}
