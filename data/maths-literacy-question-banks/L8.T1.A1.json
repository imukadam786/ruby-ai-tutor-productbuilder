    {"id": "L8.T1.A1.q02","skill": "L8.T1.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Scale 1:50 000. 1 cm map = 50 000 cm real."},"question": "3 cm on the map represents how many cm in real life?","answerMode": "numeric","expectedAnswer": 150000,"tolerance": 100,"unit": "cm","workingSteps": ["3 × 50 000 = 150 000 cm."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q03","skill": "L8.T1.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "150 000 cm in metres."},"question": "Convert 150 000 cm to m.","answerMode": "numeric","expectedAnswer": 1500,"tolerance": 5,"unit": "m","workingSteps": ["150 000 ÷ 100 = 1 500 m."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q04","skill": "L8.T1.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Bar scale: 5 cm bar = 100 m."},"question": "What is 1 cm on the bar in m?","answerMode": "numeric","expectedAnswer": 20,"tolerance": 0.5,"unit": "m","workingSteps": ["100 ÷ 5 = 20 m per cm."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q05","skill": "L8.T1.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same bar scale (1 cm = 20 m)."},"question": "8 cm on the map = ? m real.","answerMode": "numeric","expectedAnswer": 160,"tolerance": 5,"unit": "m","workingSteps": ["8 × 20 = 160 m."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q06","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Scale 1:50 000. Distance on map 4 cm."},"question": "Convert to km (real).","answerMode": "numeric","expectedAnswer": 2,"tolerance": 0.05,"unit": "km","workingSteps": ["4 × 50 000 cm = 200 000 cm = 2 000 m = 2 km."],"errorSignals": ["ERR_SCALE_DIRECTION","ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q07","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Floor plan 1:50. Lounge marked 8 cm × 6 cm on plan."},"question": "Real dimensions in m?","answerMode": "multiField","fields": [{"label": "Length (m)", "expectedAnswer": 4, "tolerance": 0.1}, {"label": "Width (m)", "expectedAnswer": 3, "tolerance": 0.1}],"workingSteps": ["8 × 50 = 400 cm = 4 m. 6 × 50 = 300 cm = 3 m."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q08","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Road map 1:100 000. Two towns 8 cm apart on map."},"question": "Real distance in km?","answerMode": "numeric","expectedAnswer": 8,"tolerance": 0.1,"unit": "km","workingSteps": ["8 × 100 000 = 800 000 cm = 8 000 m = 8 km."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q09","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Reverse: real 50 m at scale 1:500."},"question": "Map cm?","answerMode": "numeric","expectedAnswer": 10,"tolerance": 0.2,"unit": "cm","workingSteps": ["50 m = 5 000 cm. ÷ 500 = 10 cm."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q10","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Scale 1:25. Garden 6 m × 4 m."},"question": "Plan dimensions in cm?","answerMode": "multiField","fields": [{"label": "L on plan (cm)", "expectedAnswer": 24, "tolerance": 0.5}, {"label": "W on plan (cm)", "expectedAnswer": 16, "tolerance": 0.5}],"workingSteps": ["6 m ÷ 25 = 0,24 m = 24 cm. 4 m ÷ 25 = 16 cm."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q11","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Bar scale: 4 cm = 200 m. Map distance 6 cm."},"question": "Real distance m?","answerMode": "numeric","expectedAnswer": 300,"tolerance": 5,"unit": "m","workingSteps": ["1 cm = 50 m. 6 × 50 = 300 m."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q12","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Floor plan scale 1:50, bedroom marked 5 cm × 3,5 cm."},"question": "Real area m²?","answerMode": "numeric","expectedAnswer": 4.375,"tolerance": 0.1,"unit": "m²","workingSteps": ["L = 2,5 m, W = 1,75 m. Area = 2,5 × 1,75 = 4,375 m²."],"errorSignals": ["ERR_SCALE_DIRECTION","ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q13","skill": "L8.T1.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Scale 1:200 000. Map 7,5 cm."},"question": "Real distance in km?","answerMode": "numeric","expectedAnswer": 15,"tolerance": 0.1,"unit": "km","workingSteps": ["7,5 × 200 000 = 1 500 000 cm = 15 km."],"errorSignals": ["ERR_SCALE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q14","skill": "L8.T1.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Cape Town to Stellenbosch ~50 km. Map scale 1:500 000."},"question": "Map distance cm?","answerMode": "numeric","expectedAnswer": 10,"tolerance": 0.5,"unit": "cm","workingSteps": ["50 km = 5 000 000 cm ÷ 500 000 = 10 cm."],"errorSignals": ["ERR_SCALE_DIRECTION","ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L8.T1.A1.q15","skill": "L8.T1.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Site plan 1:100. Yard 24 m × 18 m."},"question": "Plan area cm²?","answerMode": "numeric","expectedAnswer": 432,"tolerance": 5,"unit": "cm²","workingSteps": ["24 m = 24 cm at 1:100. 18 m = 18 cm. Area = 24 × 18 = 432 cm²."],"errorSignals": ["ERR_SCALE_DIRECTION","ERR_AREA_FORMULA"],"passThreshold": 0.85},
