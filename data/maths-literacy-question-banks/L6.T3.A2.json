  "items": [
    {"id": "L6.T3.A2.q01","skill": "L6.T3.A2","caps_level": 1,"source": "fresh","stimulus": {"inline": "**Gautrain — Park station to OR Tambo**\n\n| Depart | Arrive |\n|---|---|\n| 06:00 | 06:25 |\n| 06:30 | 06:55 |\n| 07:00 | 07:25 |\n| 07:30 | 07:55 |\n| 08:00 | 08:25 |"},"question": "What time does the 06:30 train arrive at OR Tambo?","answerMode": "multiChoice","options": ["06:55", "07:00", "07:25", "07:30"],"expectedAnswer": "06:55","workingSteps": ["Read across the 06:30 row: 06:55."],"errorSignals": ["ERR_TIMETABLE_ROW","ERR_TIMETABLE_COL"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q02","skill": "L6.T3.A2","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same Gautrain timetable."},"question": "Journey duration on every train?","answerMode": "multiChoice","options": ["20 min", "25 min", "30 min", "55 min"],"expectedAnswer": "25 min","workingSteps": ["Each arrival is 25 min after departure."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q03","skill": "L6.T3.A2","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same Gautrain timetable."},"question": "How often do trains leave?","answerMode": "multiChoice","options": ["Every 15 min", "Every 25 min", "Every 30 min", "Every hour"],"expectedAnswer": "Every 30 min","workingSteps": ["06:00, 06:30, 07:00, … → every 30 min."],"errorSignals": ["ERR_TIMETABLE_ROW"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q04","skill": "L6.T3.A2","caps_level": 1,"source": "fresh","stimulus": {"inline": "**FlySafair JNB → CPT**\n\n| Flight | Depart | Arrive |\n|---|---|---|\n| FA101 | 06:15 | 08:25 |\n| FA205 | 12:50 | 15:00 |\n| FA309 | 17:40 | 19:50 |"},"question": "What time does flight FA205 arrive?","answerMode": "multiChoice","options": ["14:50", "15:00", "12:50", "17:50"],"expectedAnswer": "15:00","workingSteps": ["Read FA205 row, Arrive column: 15:00."],"errorSignals": ["ERR_TIMETABLE_ROW","ERR_TIMETABLE_COL"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q05","skill": "L6.T3.A2","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same FlySafair table."},"question": "Duration of FA101?","answerMode": "multiChoice","options": ["1 h 10 min", "2 h 10 min", "2 h 25 min", "8 h 25 min"],"expectedAnswer": "2 h 10 min","workingSteps": ["08:25 − 06:15 = 2 h 10 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q06","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "**Shosholoza Meyl — Joburg → Cape Town**\n\n| Station | Mon dep | Tue arr |\n|---|---|---|\n| Joburg | 12:30 |  |\n| Bloemfontein | 19:25 | 19:30 |\n| Beaufort West |  | 05:45 |\n| Cape Town |  | 11:30 |"},"question": "What is the total journey time Joburg → Cape Town?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 23, "tolerance": 1}, {"label": "Minutes", "expectedAnswer": 0, "tolerance": 30}],"workingSteps": ["12:30 Mon → 11:30 Tue = 23 h."],"errorSignals": ["ERR_TIME_DURATION_MIDNIGHT","ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q07","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same Shosholoza Meyl table — Joburg 12:30 → Bloemfontein 19:25."},"question": "Time taken for first leg?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 6, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 55, "tolerance": 1}],"workingSteps": ["19:25 − 12:30 = 6 h 55 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q08","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same Shosholoza table — Bloemfontein dep 19:30, Beaufort West arr 05:45 (next day)."},"question": "Time from Bloemfontein to Beaufort West?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 10, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 15, "tolerance": 1}],"workingSteps": ["19:30 → 24:00 = 4 h 30 min. 00:00 → 05:45 = 5 h 45 min. Total: 10 h 15 min."],"errorSignals": ["ERR_TIME_DURATION_MIDNIGHT"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q09","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same Shosholoza — Beaufort West 05:45 → Cape Town 11:30."},"question": "Last leg duration?","answerMode": "numeric","expectedAnswer": 345,"tolerance": 5,"unit": "minutes","workingSteps": ["11:30 − 05:45 = 5 h 45 min = 345 min."],"errorSignals": ["ERR_24H_TIME_CALC","ERR_TIME_HM_TO_MIN"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q10","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "Connection time: passenger arrives 14:25, next train leaves 15:15."},"question": "Time to spare?","answerMode": "numeric","expectedAnswer": 50,"tolerance": 1,"unit": "minutes","workingSteps": ["15:15 − 14:25 = 50 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q11","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "**Bus timetable — Joburg → Polokwane**\n\n| Bus | Depart | Arrive |\n|---|---|---|\n| 1 | 05:30 | 09:00 |\n| 2 | 09:00 | 12:30 |\n| 3 | 13:00 | 16:30 |\n| 4 | 17:30 | 21:00 |"},"question": "What is the journey duration (same on every bus)?","answerMode": "multiChoice","options": ["3 h", "3 h 30 min", "4 h", "4 h 30 min"],"expectedAnswer": "3 h 30 min","workingSteps": ["09:00 − 05:30 = 3 h 30 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q12","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same bus table — last bus arrives 21:00. Connecting taxi at 21:30."},"question": "Connection time?","answerMode": "numeric","expectedAnswer": 30,"tolerance": 1,"unit": "minutes","workingSteps": ["21:30 − 21:00 = 30 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q13","skill": "L6.T3.A2","caps_level": 2,"source": "fresh","stimulus": {"inline": "**FlySafair** — same table."},"question": "Approximately how long between FA101 arrival and FA205 departure (waiting time)?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 4, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 25, "tolerance": 1}],"workingSteps": ["FA101 arr 08:25; FA205 dep 12:50. Diff = 4 h 25 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q14","skill": "L6.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "**Gautrain frequency** — half-hourly between 06:00 and 21:00."},"question": "How many departures in the day?","answerMode": "numeric","expectedAnswer": 31,"tolerance": 1,"unit": "trains","workingSteps": ["From 06:00 to 21:00 is 15 hours = 30 half-hours. Inclusive of both endpoints = 31 departures."],"errorSignals": ["ERR_TIMETABLE_FREQ"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q15","skill": "L6.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Passenger missed FA101 at 06:15 (CPT-bound). Next flight FA205 at 12:50."},"question": "How long to wait?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 6, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 35, "tolerance": 1}],"workingSteps": ["12:50 − 06:15 = 6 h 35 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q16","skill": "L6.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "**Mini-bus taxi rank** — taxis leave every 15 min from 04:00 to 22:00."},"question": "How many departures per day?","answerMode": "numeric","expectedAnswer": 73,"tolerance": 1,"unit": "taxis","workingSteps": ["From 04:00 to 22:00 = 18 h = 72 quarter-hours. Inclusive: 73 departures."],"errorSignals": ["ERR_TIMETABLE_FREQ"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q17","skill": "L6.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Train from Joburg to Cape Town journey 23 h. Departure 12:30 Monday."},"question": "What day/time does it arrive?","answerMode": "multiChoice","options": ["Tuesday 11:30", "Tuesday 09:30", "Tuesday 12:30", "Monday 23:30"],"expectedAnswer": "Tuesday 11:30","workingSteps": ["12:30 + 23 h = 11:30 next day (Tuesday)."],"errorSignals": ["ERR_TIME_DURATION_MIDNIGHT"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q18","skill": "L6.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Two-flight journey — FA101 (06:15-08:25) then connecting flight 09:30 with arrival 13:00."},"question": "Total trip time?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 6, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 45, "tolerance": 1}],"workingSteps": ["13:00 − 06:15 = 6 h 45 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q19","skill": "L6.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Same trip — wait time in transit (between flights)."},"question": "Wait time?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 1, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 5, "tolerance": 1}],"workingSteps": ["09:30 − 08:25 = 1 h 5 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A2.q20","skill": "L6.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "**Bus timetable** — same as above. Last bus arr Polokwane 21:00. Final connecting taxi to Tzaneen at 21:30 takes 1 h 45 min."},"question": "Arrival in Tzaneen?","answerMode": "multiChoice","options": ["23:15", "23:30", "22:15", "00:15 (next day)"],"expectedAnswer": "23:15","workingSteps": ["21:30 + 1 h 45 min = 23:15."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85}
  ],
  "_error_signal_vocabulary": {
    "ERR_TIMETABLE_ROW": "Reads the wrong row of a timetable.",
    "ERR_TIMETABLE_COL": "Reads the wrong column (depart vs arrive).",
    "ERR_TIMETABLE_FREQ": "Misses inclusive endpoint when counting departures.",
    "ERR_24H_TIME_CALC": "Calculates duration in 24h time incorrectly.",
    "ERR_TIME_DURATION_MIDNIGHT": "Fails to split a duration crossing midnight.",
    "ERR_TIME_HM_TO_MIN": "Misconverts h+min to minutes."
