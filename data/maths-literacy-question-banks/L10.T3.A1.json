    {"id": "L10.T3.A1.q05","skill": "L10.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Mutually exclusive: P(A or B) = P(A) + P(B). Die. P(rolling 2 or 5)?"},"question": "P?","answerMode": "numeric","expectedAnswer": 0.333,"tolerance": 0.02,"workingSteps": ["1/6 + 1/6 = 2/6 = 1/3 ≈ 0,333."],"errorSignals": ["ERR_PROBABILITY_OR"],"passThreshold": 0.85},
