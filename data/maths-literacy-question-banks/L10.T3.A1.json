    {"id": "L10.T3.A1.q07","skill": "L10.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same table. P(boy)?"},"question": "P?","answerMode": "numeric","expectedAnswer": 0.45,"tolerance": 0.02,"workingSteps": ["45/100 = 0,45."],"errorSignals": ["ERR_TWOWAY_TABLE"],"passThreshold": 0.85},
    {"id": "L10.T3.A1.q08","skill": "L10.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same. P(sport)?"},"question": "P?","answerMode": "numeric","expectedAnswer": 0.6,"tolerance": 0.02,"workingSteps": ["60/100 = 0,6."],"errorSignals": ["ERR_TWOWAY_TABLE"],"passThreshold": 0.85},
    {"id": "L10.T3.A1.q09","skill": "L10.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Same. P(boy OR sport)?"},"question": "P?","answerMode": "numeric","expectedAnswer": 0.8,"tolerance": 0.05,"workingSteps": ["P(B) + P(S) − P(B and S) = 0,45 + 0,60 − 0,25 = 0,80."],"errorSignals": ["ERR_PROBABILITY_OR"],"passThreshold": 0.85},
    {"id": "L10.T3.A1.q10","skill": "L10.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Two dice rolled. Sum sample space size?"},"question": "Outcomes?","answerMode": "numeric","expectedAnswer": 36,"tolerance": 0,"workingSteps": ["6 × 6 = 36."],"errorSignals": ["ERR_SAMPLE_SPACE"],"passThreshold": 0.85},
    {"id": "L10.T3.A1.q11","skill": "L10.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Two dice. P(sum = 7)?"},"question": "P?","answerMode": "numeric","expectedAnswer": 0.167,"tolerance": 0.02,"workingSteps": ["6 ways (1+6, 2+5, …) ÷ 36 = 1/6."],"errorSignals": ["ERR_PROBABILITY_FORMULA"],"passThreshold": 0.85},
    {"id": "L10.T3.A1.q12","skill": "L10.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Two dice. P(both even)?"},"question": "P?","answerMode": "numeric","expectedAnswer": 0.25,"tolerance": 0.02,"workingSteps": ["P(even on one)=0,5; both = 0,5 × 0,5 = 0,25."],"errorSignals": ["ERR_PROBABILITY_AND"],"passThreshold": 0.85},
