    {"id": "L10.T3.A1.q03","skill": "L10.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Two coins. P(at least one head)?"},"question": "P?","answerMode": "numeric","expectedAnswer": 0.75,"tolerance": 0.05,"workingSteps": ["HH HT TH = 3/4 = 0,75."],"errorSignals": ["ERR_PROBABILITY_FORMULA"],"passThreshold": 0.85},
