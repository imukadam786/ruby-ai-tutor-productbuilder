    {"id": "L10.T3.A1.q20","skill": "L10.T3.A1","caps_level": 4,"source": "fresh","stimulus": {"inline": "Tree: rain 0,4 / not 0,6. If rain, P(late) = 0,7. If not, P(late) = 0,1."},"question": "P(late)?","answerMode": "numeric","expectedAnswer": 0.34,"tolerance": 0.02,"workingSteps": ["0,4 × 0,7 + 0,6 × 0,1 = 0,28 + 0,06 = 0,34."],"errorSignals": ["ERR_TREE_DIAGRAM"],"passThreshold": 0.85}
