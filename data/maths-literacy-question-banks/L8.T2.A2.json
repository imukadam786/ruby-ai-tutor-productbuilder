    {"id": "L8.T2.A2.q10","skill": "L8.T2.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Route plan JNB → CPT → DBN. Total km?"},"question": "Total km?","answerMode": "numeric","expectedAnswer": 3100,"tolerance": 50,"unit": "km","workingSteps": ["JNB-CPT 1 400 + CPT-DBN 1 700 = 3 100 km."],"errorSignals": ["ERR_TABLE_LOOKUP","ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q11","skill": "L8.T2.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "DBN-PTA-JNB; consumption 9 L/100, petrol R24/L."},"question": "Fuel cost?","answerMode": "numeric","expectedAnswer": 1490,"tolerance": 30,"unit": "R","workingSteps": ["Distance: 640 + 50 = 690 km. Fuel: 690 ÷ 100 × 9 = 62,1 L. Cost: 62,1 × R24 ≈ R1 490."],"errorSignals": ["ERR_RATE_USE_OPERATION","ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q12","skill": "L8.T2.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Compare routes JNB→DBN direct (590 km) vs via PTA (690 km). 9 L/100 km, R24/L petrol."},"question": "Direct vs via-PTA fuel cost difference?","answerMode": "numeric","expectedAnswer": 216,"tolerance": 10,"unit": "R","workingSteps": ["Direct: 590÷100×9×24 = R1 274,4. Via PTA: 690÷100×9×24 = R1 490,4. Diff = R216."],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q13","skill": "L8.T2.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "JNB-CPT 1 400 km. Two refuel stops 15 min each + 45 min lunch."},"question": "Total stop time?","answerMode": "numeric","expectedAnswer": 75,"tolerance": 5,"unit": "minutes","workingSteps": ["15+15+45 = 75 min."],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q14","skill": "L8.T2.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "From above: total trip time at 100 km/h?"},"question": "Trip time h:min?","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 15, "tolerance": 0.5}, {"label": "Minutes", "expectedAnswer": 15, "tolerance": 5}],"workingSteps": ["Drive: 14 h. Stops: 75 min = 1 h 15 min. Total: 15 h 15 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q15","skill": "L8.T2.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Distance chart again. 50 km from JNB to PTA."},"question": "At 60 km/h commuter speed, time?","answerMode": "numeric","expectedAnswer": 50,"tolerance": 5,"unit": "minutes","workingSteps": ["50 ÷ 60 ≈ 0,83 h × 60 = 50 min."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE","ERR_TIME_HM_TO_MIN"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q16","skill": "L8.T2.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Same JNB-PTA, petrol R23,50/L, car 7 L/100 km."},"question": "Cost?","answerMode": "numeric","expectedAnswer": 82.25,"tolerance": 2,"unit": "R","workingSteps": ["50÷100×7 = 3,5 L. Cost = 3,5 × R23,50 = R82,25."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q17","skill": "L8.T2.A2","caps_level": 4,"source": "fresh","stimulus": {"inline": "Choose between 2 routes to deliver goods JNB-Polokwane.\n\n- Route A: 320 km, 100 km/h, 7 L/100.\n- Route B: 380 km (avoid traffic), 110 km/h, 7 L/100."},"question": "Time difference (minutes) — which is faster and by how much?","answerMode": "multiField","fields": [{"label": "Faster route", "expectedAnswer": "A"}, {"label": "Time saved (min)", "expectedAnswer": 15, "tolerance": 5}],"workingSteps": ["Route A time: 320 ÷ 100 = 3,20 h = 192 min.","Route B time: 380 ÷ 110 ≈ 3,45 h ≈ 207 min.","Difference: 207 − 192 = 15 min.","Route A is faster by 15 min."],"errorSignals": ["ERR_SPEED_TIME_DISTANCE","ERR_TIME_HM_TO_MIN"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q18","skill": "L8.T2.A2","caps_level": 4,"source": "fresh","stimulus": {"inline": "Same: which uses LESS fuel?"},"question": "Less-fuel route and L saved?","answerMode": "multiField","fields": [{"label": "Less-fuel route", "expectedAnswer": "A"}, {"label": "L saved", "expectedAnswer": 4.2, "tolerance": 0.5}],"workingSteps": ["A: 320×0,07 = 22,4 L. B: 380×0,07 = 26,6 L. A saves 4,2 L."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L8.T2.A2.q19","skill": "L8.T2.A2","caps_level": 4,"source": "fresh","stimulus": {"inline": "Cost-per-km. JNB-CPT 1 400 km; 8 L/100; R23,50/L; plus tolls R250."},"question": "Cost per km?","answerMode": "numeric","expectedAnswer": 2.06,"tolerance": 0.1,"unit": "R/km","workingSteps": ["Fuel: 112 × R23,50 = R2 632. Tolls R250. Total R2 882. Per km: R2 882 ÷ 1 400 ≈ R2,06/km."],"errorSignals": ["ERR_BALANCE_RUNNING","ERR_UNIT_PRICE_INVERSION"],"passThreshold": 0.85},
