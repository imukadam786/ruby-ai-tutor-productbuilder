  "items": [
    {"id": "L8.T4.A1.q01","skill": "L8.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "A net of a cube has 6 squares folded together. Side 5 cm."},"question": "Total area of net?","answerMode": "numeric","expectedAnswer": 150,"tolerance": 1,"unit": "cm²","workingSteps": ["6 × 25 = 150 cm²."],"errorSignals": ["ERR_SA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q02","skill": "L8.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Net of cube above folded into a model."},"question": "Volume of model?","answerMode": "numeric","expectedAnswer": 125,"tolerance": 1,"unit": "cm³","workingSteps": ["V = 5³ = 125."],"errorSignals": ["ERR_VOLUME_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q03","skill": "L8.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Box 4 × 3 × 2 cm."},"question": "Volume?","answerMode": "numeric","expectedAnswer": 24,"tolerance": 0.5,"unit": "cm³","workingSteps": ["4×3×2 = 24 cm³."],"errorSignals": ["ERR_VOLUME_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q04","skill": "L8.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Cereal box: 30 × 20 × 6 cm. Cube-pack: 16 × 16 × 16 cm. Compare volumes."},"question": "Cereal vs cube volumes — which holds more?","answerMode": "multiField","fields": [{"label": "Bigger volume", "expectedAnswer": "Cube"}, {"label": "Difference (cm³)", "expectedAnswer": 496, "tolerance": 20}],"workingSteps": ["Cereal: 30×20×6 = 3 600. Cube: 16³ = 4 096. Cube larger by 496."],"errorSignals": ["ERR_VOLUME_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q05","skill": "L8.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same boxes. Compare cardboard area (SA)."},"question": "SA of each.","answerMode": "multiField","fields": [{"label": "Cereal SA (cm²)", "expectedAnswer": 1800, "tolerance": 20}, {"label": "Cube SA (cm²)", "expectedAnswer": 1536, "tolerance": 20}],"workingSteps": ["Cereal: 2(600+180+120) = 1 800.","Cube: 6 × 256 = 1 536."],"errorSignals": ["ERR_SA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q06","skill": "L8.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Two cereal packs. Both same volume 3 600 cm³. Pack A: 30×20×6. Pack B: 20×15×12."},"question": "Which uses LESS cardboard?","answerMode": "multiChoice","options": ["Pack A", "Pack B", "Same", "Cannot tell"],"expectedAnswer": "Pack B","workingSteps": ["A: 2(600+180+120) = 1 800. B: 2(300+240+180) = 1 440. B uses less."],"errorSignals": ["ERR_SA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q07","skill": "L8.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Cylinder can r=4 cm h=10 cm, π=3,14. Volume?"},"question": "Volume?","answerMode": "numeric","expectedAnswer": 502.4,"tolerance": 5,"unit": "cm³","workingSteps": ["3,14 × 16 × 10 = 502,4."],"errorSignals": ["ERR_CYLINDER_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q08","skill": "L8.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Compare cubic box (vol 512 cm³) vs cylinder (vol 502 cm³). Bigger?"},"question": "Bigger volume?","answerMode": "multiChoice","options": ["Cubic", "Cylinder", "Same", "Cannot tell"],"expectedAnswer": "Cubic","workingSteps": ["512 > 502 → cubic."],"errorSignals": ["ERR_VOLUME_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q09","skill": "L8.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Cube side 8 cm vs cylinder r=4, h=10."},"question": "Which uses LESS material (SA)?","answerMode": "multiChoice","options": ["Cube", "Cylinder", "Same", "Cannot tell"],"expectedAnswer": "Cylinder","workingSteps": ["Cube SA = 6 × 8² = 6 × 64 = 384 cm².","Cylinder SA = 2πr² + 2πrh = 2π(16) + 2π(40) = 32π + 80π ≈ 100,5 + 251,2 = 351,7 cm².","Cylinder SA (351,7) < Cube SA (384), so the cylinder uses less material."],"errorSignals": ["ERR_SA_FORMULA","ERR_SA_CYLINDER_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q10","skill": "L8.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Open box (no lid) 4 × 3 × 2 cm. Cardboard area = bottom + 2 long sides + 2 short sides."},"question": "Cardboard area cm²?","answerMode": "numeric","expectedAnswer": 40,"tolerance": 2,"unit": "cm²","workingSteps": ["Bottom 12 + 2×8 + 2×6 = 12 + 16 + 12 = 40."],"errorSignals": ["ERR_SA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q11","skill": "L8.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Two boxes: A (10×10×10 = 1 000 cm³), B (8×8×16 = 1 024 cm³)."},"question": "Bigger holding box?","answerMode": "multiChoice","options": ["A", "B", "Same", "Cannot tell"],"expectedAnswer": "B","workingSteps": ["1 024 > 1 000."],"errorSignals": ["ERR_VOLUME_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q12","skill": "L8.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Same A and B; compare SA."},"question": "Less cardboard?","answerMode": "multiChoice","options": ["A", "B", "Same", "Cannot tell"],"expectedAnswer": "A","workingSteps": ["A SA: 6×100 = 600. B SA: 2(64+128+128) = 640. A less."],"errorSignals": ["ERR_SA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q13","skill": "L8.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Cylindrical can r=3 cm, h=10 cm vs rect box 6×6×8 cm."},"question": "Which holds more (volume)?","answerMode": "multiField","fields": [{"label": "Bigger holder", "expectedAnswer": "Box"}, {"label": "Difference (cm³)", "expectedAnswer": 5, "tolerance": 10}],"workingSteps": ["Cylinder V: 3,14×9×10 = 282,6. Box V: 6×6×8 = 288. Box bigger by ~5 cm³."],"errorSignals": ["ERR_VOLUME_FORMULA","ERR_CYLINDER_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q14","skill": "L8.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Pack of 6 cans (r=3, h=10) in a single-layer 2×3 array."},"question": "Approximate box dimensions to hold them?","answerMode": "multiChoice","options": ["18 × 12 × 10 cm", "12 × 18 × 5 cm", "6 × 6 × 10 cm", "9 × 9 × 10 cm"],"expectedAnswer": "18 × 12 × 10 cm","workingSteps": ["3 cans wide × diameter 6 cm = 18 cm; 2 deep × 6 cm = 12 cm; h = 10 cm."],"errorSignals": ["ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q15","skill": "L8.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Box for 12 cookies. Each cookie 6 cm diameter, packed in single layer 4 × 3 array."},"question": "Approx box size?","answerMode": "multiChoice","options": ["24 × 18 × 2 cm", "12 × 9 × 2 cm", "24 × 18 × 18 cm", "12 × 12 × 2 cm"],"expectedAnswer": "24 × 18 × 2 cm","workingSteps": ["4 × 6 = 24; 3 × 6 = 18; h slight (~2 cm)."],"errorSignals": ["ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q16","skill": "L8.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Two packs same volume 750 ml: tall thin 6×6×20 vs short stout 10×10×7,5 (units cm)."},"question": "SA comparison.","answerMode": "multiField","fields": [{"label": "Less SA pack", "expectedAnswer": "Short"}, {"label": "Difference (cm²)", "expectedAnswer": 52, "tolerance": 20}],"workingSteps": ["Tall pack SA: 2(6×6 + 6×20 + 6×20) = 2(36 + 120 + 120) = 552 cm².","Short pack SA: 2(10×10 + 10×7,5 + 10×7,5) = 2(100 + 75 + 75) = 500 cm².","Difference: 552 − 500 = 52 cm² — the short pack uses less material."],"errorSignals": ["ERR_SA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q17","skill": "L8.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Wrap a 30×20×15 cm box. Wrap = SA + 10%."},"question": "Wrap area cm²?","answerMode": "numeric","expectedAnswer": 2970,"tolerance": 30,"unit": "cm²","workingSteps": ["Surface area of the box: SA = 2(lw + lh + wh) = 2(30×20 + 30×15 + 20×15) = 2(600 + 450 + 300) = 2 700 cm².","Wrap allowance: 10% of 2 700 = 270 cm².","Total wrap area: 2 700 + 270 = 2 970 cm²."],"errorSignals": ["ERR_SA_FORMULA"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q18","skill": "L8.T4.A1","caps_level": 4,"source": "fresh","stimulus": {"inline": "Recommendation: same product (250 ml) packaged as cylindrical can (r=3, h~8,8) vs square base box (5×5×10). Which is better for SHELF-EFFICIENT packing (less wasted shelf space)?"},"question": "Better for shelf packing?","answerMode": "multiChoice","options": ["Cylinder (circle pack has gaps)", "Box (rectangles tile perfectly)", "Same", "Neither — both inefficient"],"expectedAnswer": "Box (rectangles tile perfectly)","workingSteps": ["Cylinders leave gaps when packed. Boxes tile."],"errorSignals": ["ERR_LAYOUT_CRITIQUE"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q19","skill": "L8.T4.A1","caps_level": 4,"source": "fresh","stimulus": {"inline": "Cube of side 10 cm cardboard cost R12 (for SA = 600 cm²)."},"question": "Cost per cm² of cardboard?","answerMode": "numeric","expectedAnswer": 0.02,"tolerance": 0.005,"unit": "R/cm²","workingSteps": ["R12 ÷ 600 = R0,02/cm²."],"errorSignals": ["ERR_UNIT_PRICE_INVERSION"],"passThreshold": 0.85},
    {"id": "L8.T4.A1.q20","skill": "L8.T4.A1","caps_level": 4,"source": "fresh","stimulus": {"inline": "Recommendation: same volume juice 1 L packaged as carton (10×6×17 cm) vs bottle (cylinder d=8, h~19.9). For minimising MATERIAL cost which is preferred? Compute SA."},"question": "Less SA (less material)?","answerMode": "multiChoice","options": ["Carton", "Bottle", "Same", "Cannot tell"],"expectedAnswer": "Bottle","workingSteps": ["Carton SA: 2(60+170+102) = 664 cm². Bottle SA: 2π(16) + 2π(4)(19.9) ≈ 100,5 + 500,3 = 600,8 cm². Bottle uses ~63 cm² less."],"errorSignals": ["ERR_SA_FORMULA","ERR_SA_CYLINDER_FORMULA"],"passThreshold": 0.85}
  ],
