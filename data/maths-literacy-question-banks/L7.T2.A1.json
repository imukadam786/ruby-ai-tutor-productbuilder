    {"id": "L7.T2.A1.q18","skill": "L7.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Garden 15 m × 9 m. Fence costs R65/m + R250 setup fee."},"question": "Total cost?","answerMode": "numeric","expectedAnswer": 3370,"tolerance": 20,"unit": "R","workingSteps": ["P = 2(15+9) = 48 m. Cost = 48 × R65 + R250 = R3 120 + R250 = R3 370."],"errorSignals": ["ERR_BRACKET_MISSING_FORMULA"],"passThreshold": 0.85},
