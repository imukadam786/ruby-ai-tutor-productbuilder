    {"id": "L7.T2.A1.q15","skill": "L7.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Soccer pitch 100 m × 60 m. Running track to be 4 laps around perimeter."},"question": "Total running distance?","answerMode": "numeric","expectedAnswer": 1280,"tolerance": 10,"unit": "m","workingSteps": ["P = 2(100+60) = 320 m. 4 laps = 1 280 m."],"errorSignals": ["ERR_BRACKET_MISSING_FORMULA"],"passThreshold": 0.85},
