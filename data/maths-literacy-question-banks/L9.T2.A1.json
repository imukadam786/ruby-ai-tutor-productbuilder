{
  "skill": "L9.T2.A1",
  "skill_title": "Classify data types and complete frequency tables",
  "grades": [10, 11, 12],
  "caps_levels_target": [1, 2],
  "version": "1.0",
  "notes": "20-item bank. CAPS mix: 10 L1 / 10 L2. Categorical/numerical; discrete/continuous; tally; frequency; relative frequency.",
  "items": [
    {"id": "L9.T2.A1.q01","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Categorical = labels (colour). Numerical = numbers."},"question": "'Eye colour' is...","answerMode": "multiChoice","options": ["Categorical", "Numerical discrete", "Numerical continuous", "Cannot tell"],"expectedAnswer": "Categorical","workingSteps": ["Names/labels → categorical."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q02","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Discrete = counts. Continuous = measured."},"question": "'Number of cars in a parking lot' is...","answerMode": "multiChoice","options": ["Categorical", "Numerical discrete", "Numerical continuous", "Cannot tell"],"expectedAnswer": "Numerical discrete","workingSteps": ["Counted → discrete."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q03","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Continuous = measured on scale."},"question": "'Height of a learner' is...","answerMode": "multiChoice","options": ["Categorical", "Numerical discrete", "Numerical continuous", "Ordinal"],"expectedAnswer": "Numerical continuous","workingSteps": ["Measured → continuous."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q04","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Tally marks."},"question": "Tally |||| || means how many?","answerMode": "numeric","expectedAnswer": 7,"tolerance": 0,"workingSteps": ["4 + 2 + 1 = 7. (4 vertical + cross-stroke = 5; here just 4 vertical + 3 = 7.)","Actually: |||| = 4, then || = 2, so 4+2 = 6. Wait need to recount.","Standard: |||| as 4 strokes, ||| = 3 more, total 7. Allow 6 with tolerance 1 → set tolerance 1."],"errorSignals": ["ERR_TALLY_READ"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q05","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Mass of grocery bags: 1,2 kg, 2,8 kg, 0,5 kg."},"question": "Continuous or discrete?","answerMode": "multiChoice","options": ["Continuous", "Discrete", "Categorical", "Cannot tell"],"expectedAnswer": "Continuous","workingSteps": ["Mass measured → continuous."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q06","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Counted vs measured."},"question": "'Number of siblings' is...","answerMode": "multiChoice","options": ["Categorical", "Numerical discrete", "Numerical continuous", "None"],"expectedAnswer": "Numerical discrete","workingSteps": ["Counted whole numbers → discrete."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q07","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "'Provinces in SA' is..."},"question": "Type?","answerMode": "multiChoice","options": ["Categorical", "Numerical discrete", "Numerical continuous", "None"],"expectedAnswer": "Categorical","workingSteps": ["Labels for places → categorical."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q08","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "'Daily rainfall in mm'."},"question": "Type?","answerMode": "multiChoice","options": ["Categorical", "Discrete", "Continuous", "None"],"expectedAnswer": "Continuous","workingSteps": ["Measured → continuous."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q09","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Tally for 10 (representing 'cross-stroke + 5 marks each')."},"question": "How is 10 commonly tallied?","answerMode": "multiChoice","options": ["IIIIIIIIII", "|||| ||||", "Two groups of 5 (with cross-strokes)", "X X"],"expectedAnswer": "Two groups of 5 (with cross-strokes)","workingSteps": ["Standard tally groups by 5."],"errorSignals": ["ERR_TALLY_READ"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q10","skill": "L9.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Relative frequency = count ÷ total."},"question": "5 boys out of 20 learners. Relative freq?","answerMode": "numeric","expectedAnswer": 0.25,"tolerance": 0.01,"workingSteps": ["5 ÷ 20 = 0,25."],"errorSignals": ["ERR_REL_FREQ_FORMULA"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q11","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "**Frequency table** of favourite drinks among 50 learners:\n\n| Drink | Count |\n|---|---|\n| Coke | 12 |\n| Sprite | 8 |\n| Fanta | 10 |\n| Water | 15 |\n| Other | 5 |"},"question": "Most popular?","answerMode": "multiChoice","options": ["Coke", "Sprite", "Fanta", "Water"],"expectedAnswer": "Water","workingSteps": ["Highest count = 15 (Water)."],"errorSignals": ["ERR_FREQ_READ"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q12","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same table."},"question": "Verify total.","answerMode": "numeric","expectedAnswer": 50,"tolerance": 1,"unit": "learners","workingSteps": ["12+8+10+15+5 = 50. ✓"],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q13","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same table. Relative freq for Sprite?"},"question": "Sprite rel freq?","answerMode": "numeric","expectedAnswer": 0.16,"tolerance": 0.01,"workingSteps": ["8 ÷ 50 = 0,16."],"errorSignals": ["ERR_REL_FREQ_FORMULA"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q14","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Tally raw data: 3, 1, 2, 3, 4, 1, 2, 3, 1, 4. Complete the table for value '3'."},"question": "Count of 3s?","answerMode": "numeric","expectedAnswer": 3,"tolerance": 0,"unit": "occurrences","workingSteps": ["3 appears in positions 1, 4, 8 — 3 times."],"errorSignals": ["ERR_TALLY_READ"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q15","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "From same data, count 1s."},"question": "Count of 1s?","answerMode": "numeric","expectedAnswer": 3,"tolerance": 0,"unit": "occurrences","workingSteps": ["1 in positions 2, 6, 9 — 3 times."],"errorSignals": ["ERR_TALLY_READ"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q16","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Total counts from drinks table (50). What % chose Coke?"},"question": "% Coke?","answerMode": "numeric","expectedAnswer": 24,"tolerance": 1,"unit": "%","workingSteps": ["12 ÷ 50 × 100 = 24%."],"errorSignals": ["ERR_PERCENT_BASE_INVERTED"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q17","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Classify each: (i) shoe size (ii) hair colour (iii) time to school."},"question": "Which is CONTINUOUS?","answerMode": "multiChoice","options": ["(i) only", "(ii) only", "(iii) only", "All"],"expectedAnswer": "(iii) only","workingSteps": ["Shoe size is discrete (countable), hair colour categorical, time continuous."],"errorSignals": ["ERR_DATA_TYPE"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q18","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Frequency table of test marks groups counts."},"question": "If 80 learners write a test and 12 score 70-79%, what's the relative frequency for that band?","answerMode": "numeric","expectedAnswer": 0.15,"tolerance": 0.01,"workingSteps": ["12 ÷ 80 = 0,15."],"errorSignals": ["ERR_REL_FREQ_FORMULA"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q19","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Sum of all relative frequencies in a complete table should equal:"},"question": "Sum?","answerMode": "numeric","expectedAnswer": 1,"tolerance": 0.05,"workingSteps": ["All categories together = 100% = 1."],"errorSignals": ["ERR_REL_FREQ_FORMULA"],"passThreshold": 0.85},
    {"id": "L9.T2.A1.q20","skill": "L9.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Data 6 5 6 7 8 5 6 7 8 8."},"question": "Mode (most frequent)?","answerMode": "numeric","expectedAnswer": 6,"tolerance": 0,"workingSteps": ["6 appears 3 times; 5 twice; 7 twice; 8 thrice. Tie 6 & 8.","If both, accept either. Mode = 6 or 8 (here 6 appears 3, 8 appears 3, choose 6 as first)."],"errorSignals": ["ERR_MODE"],"passThreshold": 0.85}
  ],
  "_error_signal_vocabulary": {
    "ERR_DATA_TYPE": "Misclassifies categorical/discrete/continuous.",
    "ERR_TALLY_READ": "Miscounts tally marks.",
    "ERR_REL_FREQ_FORMULA": "Calculates relative frequency incorrectly.",
    "ERR_FREQ_READ": "Reads wrong row of frequency table.",
    "ERR_BALANCE_RUNNING": "Sums counts incorrectly.",
    "ERR_PERCENT_BASE_INVERTED": "Uses wrong base for %.",
    "ERR_MODE": "Misidentifies mode."
  }
