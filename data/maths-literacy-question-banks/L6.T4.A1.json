  "notes": "20-item bank. CAPS mix: 3 L1 / 7 L2 / 7 L3 / 3 L4. Read thermometers, interpret forecasts, decide actions (e.g. > 38°C fever).",
  "items": [
    {"id": "L6.T4.A1.q01","skill": "L6.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Digital thermometer reads 36,8 °C."},"question": "What is the reading?","answerMode": "numeric","expectedAnswer": 36.8,"tolerance": 0.1,"unit": "°C","workingSteps": ["Read display: 36,8 °C."],"errorSignals": ["ERR_DOCUMENT_FIELD"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q02","skill": "L6.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Thermometer scale with 1 °C increments. Mercury reaches 18 °C."},"question": "Reading?","answerMode": "numeric","expectedAnswer": 18,"tolerance": 1,"unit": "°C","workingSteps": ["Read: 18 °C."],"errorSignals": ["ERR_DOCUMENT_FIELD"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q03","skill": "L6.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Negative temperature (cold storage). Display: −18 °C."},"question": "Reading?","answerMode": "numeric","expectedAnswer": -18,"tolerance": 1,"unit": "°C","workingSteps": ["Read negative value: −18 °C."],"errorSignals": ["ERR_SIGNED_VALUE_DIRECTION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q04","skill": "L6.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "**Weather forecast — Cape Town**\n\n| Day | Min (°C) | Max (°C) |\n|---|---|---|\n| Mon | 12 | 22 |\n| Tue | 14 | 24 |\n| Wed | 13 | 21 |\n| Thu | 10 | 19 |\n| Fri | 11 | 23 |"},"question": "Hottest forecast day?","answerMode": "multiChoice","options": ["Monday", "Tuesday", "Wednesday", "Thursday"],"expectedAnswer": "Tuesday","workingSteps": ["Tue max = 24, the highest."],"errorSignals": ["ERR_MAX_MIN_READ"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q05","skill": "L6.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same CPT forecast."},"question": "Coldest minimum?","answerMode": "numeric","expectedAnswer": 10,"tolerance": 0.5,"unit": "°C","workingSteps": ["Min column: 12, 14, 13, 10, 11 → min = 10 (Thu)."],"errorSignals": ["ERR_MAX_MIN_READ"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q06","skill": "L6.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same forecast."},"question": "Calculate Tuesday's temperature range (max − min).","answerMode": "numeric","expectedAnswer": 10,"tolerance": 0.5,"unit": "°C","workingSteps": ["24 − 14 = 10 °C."],"errorSignals": ["ERR_NEGATIVE_SUBTRACTION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q07","skill": "L6.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Body temperature: above 38 °C indicates fever."},"question": "Thermometer reads 38,3 °C. Action?","answerMode": "multiChoice","options": ["Healthy — no action.", "Mild fever — monitor and see a doctor if it rises.", "Hypothermia.", "Cool air room temperature."],"expectedAnswer": "Mild fever — monitor and see a doctor if it rises.","workingSteps": ["38,3 > 38 → fever range."],"errorSignals": ["ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q08","skill": "L6.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Freezer maintenance: should be ≤ −18 °C."},"question": "Reading −15 °C. Is the freezer cold enough?","answerMode": "multiChoice","options": ["Yes — cold enough.", "No — too warm, food may spoil.", "Exactly at limit.", "No data."],"expectedAnswer": "No — too warm, food may spoil.","workingSteps": ["−15 > −18 → too warm."],"errorSignals": ["ERR_NEGATIVE_COMPARISON","ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q09","skill": "L6.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Temperature change. From 14 °C to −3 °C (overnight)."},"question": "Calculate the change.","answerMode": "numeric","expectedAnswer": -17,"tolerance": 0.5,"unit": "°C","workingSteps": ["−3 − 14 = −17 (a drop of 17 °C)."],"errorSignals": ["ERR_NEGATIVE_SUBTRACTION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q10","skill": "L6.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Weekly forecast — avg of max temps."},"question": "Avg of Mon-Fri max temperatures (22, 24, 21, 19, 23)?","answerMode": "numeric","expectedAnswer": 21.8,"tolerance": 0.5,"unit": "°C","workingSteps": ["(22+24+21+19+23) ÷ 5 = 109 ÷ 5 = 21,8 °C."],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q11","skill": "L6.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Hospital admission: above 39 °C urgent."},"question": "Reading 39,2 °C. Action?","answerMode": "multiChoice","options": ["No action.", "Mild fever, take Panado.", "High fever — get urgent medical help.", "Normal."],"expectedAnswer": "High fever — get urgent medical help.","workingSteps": ["39,2 > 39 → urgent."],"errorSignals": ["ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q12","skill": "L6.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Refrigerator should be 1–4 °C. Reading 6 °C."},"question": "Status?","answerMode": "multiChoice","options": ["In range.", "Too cold — items may freeze.", "Too warm — food spoils faster.", "Cannot tell."],"expectedAnswer": "Too warm — food spoils faster.","workingSteps": ["6 > 4 → too warm."],"errorSignals": ["ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q13","skill": "L6.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Sutherland in July often goes below 0 °C. Min reading −9 °C overnight; recovered to 8 °C by noon."},"question": "Temperature rise?","answerMode": "numeric","expectedAnswer": 17,"tolerance": 0.5,"unit": "°C","workingSteps": ["8 − (−9) = 17 °C rise."],"errorSignals": ["ERR_NEGATIVE_SUBTRACTION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q14","skill": "L6.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Baking instruction: 'pre-heat to 180 °C'. Oven shows 165 °C."},"question": "How much more does it need to heat?","answerMode": "numeric","expectedAnswer": 15,"tolerance": 1,"unit": "°C","workingSteps": ["180 − 165 = 15 °C."],"errorSignals": ["ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q15","skill": "L6.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Convert oven 180 °C to °F for an American recipe (F = 1,8C + 32)."},"question": "180 °C in °F?","answerMode": "numeric","expectedAnswer": 356,"tolerance": 1,"unit": "°F","workingSteps": ["1,8 × 180 + 32 = 324 + 32 = 356."],"errorSignals": ["ERR_BRACKET_MISSING_FORMULA"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q16","skill": "L6.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Forecast: Mon 22 °C max, Fri 23 °C max."},"question": "Calculate % change from Mon → Fri.","answerMode": "numeric","expectedAnswer": 4.5,"tolerance": 0.5,"unit": "%","workingSteps": ["(23 − 22) ÷ 22 × 100 ≈ 4,55%."],"errorSignals": ["ERR_PERCENT_CHANGE_DIVISOR"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q17","skill": "L6.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Day's avg: (max + min) ÷ 2. Tue max 24, min 14."},"question": "Avg?","answerMode": "numeric","expectedAnswer": 19,"tolerance": 0.5,"unit": "°C","workingSteps": ["(24 + 14) ÷ 2 = 19 °C."],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q18","skill": "L6.T4.A1","caps_level": 4,"source": "fresh","stimulus": {"inline": "Action thresholds. Recipe: yeast dies above 50 °C; bread proves best at 27-32 °C. Water reading 48 °C."},"question": "Action for proving bread?","answerMode": "multiChoice","options": ["Use immediately.", "Cool to 27-32 °C first.", "Heat to 60 °C.", "Add ice to drop to 0 °C."],"expectedAnswer": "Cool to 27-32 °C first.","workingSteps": ["48 °C is above the proving range; needs cooling."],"errorSignals": ["ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q19","skill": "L6.T4.A1","caps_level": 4,"source": "fresh","stimulus": {"inline": "Convert mass-flu cluster decision: temp ≥ 37,8 °C triggers home isolation; ≥ 39 °C triggers hospital. Reading 38,9 °C."},"question": "Action?","answerMode": "multiChoice","options": ["Hospital.", "Isolate at home (monitor).", "Continue to school.", "No action."],"expectedAnswer": "Isolate at home (monitor).","workingSteps": ["38,9 is between 37,8 and 39 → home isolation."],"errorSignals": ["ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85},
    {"id": "L6.T4.A1.q20","skill": "L6.T4.A1","caps_level": 4,"source": "fresh","stimulus": {"inline": "Cold-chain transport: vaccines need 2–8 °C. Truck thermometer reads 9,5 °C."},"question": "Is the vaccine still safe?","answerMode": "multiChoice","options": ["Yes — within 1 degree of range.", "No — outside the safe range; vaccines may be compromised.", "Yes — anything below 10 °C is fine.", "Cannot tell."],"expectedAnswer": "No — outside the safe range; vaccines may be compromised.","workingSteps": ["9,5 > 8 → out of range."],"errorSignals": ["ERR_THRESHOLD_INTERPRETATION"],"passThreshold": 0.85}
  ],
