  "items": [
    {"id": "L9.T4.A1.q01","skill": "L9.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "**Bar chart — favourite drink:** Coke 12, Sprite 8, Fanta 10, Water 15."},"question": "Most popular?","answerMode": "multiChoice","options": ["Coke", "Sprite", "Fanta", "Water"],"expectedAnswer": "Water","workingSteps": ["Highest bar = Water (15)."],"errorSignals": ["ERR_CHART_READ"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q02","skill": "L9.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same data."},"question": "How many chose Fanta?","answerMode": "numeric","expectedAnswer": 10,"tolerance": 1,"workingSteps": ["Read Fanta bar: 10."],"errorSignals": ["ERR_CHART_READ"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q03","skill": "L9.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Choose right chart. Comparing parts of a whole (e.g. budget shares)."},"question": "Best chart?","answerMode": "multiChoice","options": ["Bar", "Pie", "Line", "Histogram"],"expectedAnswer": "Pie","workingSteps": ["Pie shows parts of whole."],"errorSignals": ["ERR_CHART_PICK"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q04","skill": "L9.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Comparing categories side-by-side."},"question": "Best chart?","answerMode": "multiChoice","options": ["Bar", "Pie", "Line", "Histogram"],"expectedAnswer": "Bar","workingSteps": ["Bar best for categorical comparison."],"errorSignals": ["ERR_CHART_PICK"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q05","skill": "L9.T4.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Trend over time."},"question": "Best chart?","answerMode": "multiChoice","options": ["Bar", "Pie", "Line", "Histogram"],"expectedAnswer": "Line","workingSteps": ["Line shows change over time."],"errorSignals": ["ERR_CHART_PICK"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q06","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "**Pie chart — household budget:** Rent 40%, Food 25%, Transport 15%, Savings 10%, Other 10%. Income R20 000."},"question": "Rand for rent?","answerMode": "numeric","expectedAnswer": 8000,"tolerance": 50,"unit": "R","workingSteps": ["40% × R20 000 = R8 000."],"errorSignals": ["ERR_PERCENT_TO_DECIMAL"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q07","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same pie."},"question": "Sum check: do percentages add to 100?","answerMode": "multiChoice","options": ["Yes — 100%", "No — only 95%", "No — 105%", "Cannot determine"],"expectedAnswer": "Yes — 100%","workingSteps": ["40+25+15+10+10 = 100."],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q08","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "**Line graph — monthly profit (R thousand)**\n\n| Month | Profit |\n|---|---|\n| Jan | 20 |\n| Feb | 25 |\n| Mar | 28 |\n| Apr | 22 |\n| May | 30 |"},"question": "Highest profit month?","answerMode": "multiChoice","options": ["Jan", "Feb", "Mar", "May"],"expectedAnswer": "May","workingSteps": ["Highest = 30 (May)."],"errorSignals": ["ERR_CHART_READ"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q09","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same line graph."},"question": "Trend Jan-Mar?","answerMode": "multiChoice","options": ["Up", "Down", "Constant", "Mixed"],"expectedAnswer": "Up","workingSteps": ["20 → 25 → 28: rising."],"errorSignals": ["ERR_CHART_READ"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q10","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "**Histogram** — exam marks grouped:\n\n| Range | Count |\n|---|---|\n| 0-49 | 4 |\n| 50-59 | 8 |\n| 60-69 | 15 |\n| 70-79 | 12 |\n| 80-100 | 6 |"},"question": "Total learners?","answerMode": "numeric","expectedAnswer": 45,"tolerance": 1,"workingSteps": ["4+8+15+12+6 = 45."],"errorSignals": ["ERR_BALANCE_RUNNING"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q11","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Same histogram."},"question": "Most common mark band?","answerMode": "multiChoice","options": ["0-49", "50-59", "60-69", "70-79"],"expectedAnswer": "60-69","workingSteps": ["Highest count = 15 (60-69)."],"errorSignals": ["ERR_CHART_READ"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q12","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Pie chart segments. 60° slice of full 360°."},"question": "Slice's % of whole?","answerMode": "numeric","expectedAnswer": 16.7,"tolerance": 1,"unit": "%","workingSteps": ["60 ÷ 360 × 100 ≈ 16,67%."],"errorSignals": ["ERR_PIE_DEGREES"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q13","skill": "L9.T4.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Pie for 25% of budget. Degrees?"},"question": "Slice degrees?","answerMode": "numeric","expectedAnswer": 90,"tolerance": 1,"unit": "°","workingSteps": ["25% × 360 = 90°."],"errorSignals": ["ERR_PIE_DEGREES"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q14","skill": "L9.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Histogram suits CONTINUOUS data — bars touch (no gaps)."},"question": "Bar chart vs histogram — which is for categorical?","answerMode": "multiChoice","options": ["Bar", "Histogram", "Both", "Neither"],"expectedAnswer": "Bar","workingSteps": ["Bar for categorical (bars have gaps); histogram for continuous (touching bars)."],"errorSignals": ["ERR_CHART_PICK"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q15","skill": "L9.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "**Pie** of TV time: Sports 25%, News 20%, Drama 30%, Comedy 15%, Other 10%."},"question": "Degrees for Drama?","answerMode": "numeric","expectedAnswer": 108,"tolerance": 2,"unit": "°","workingSteps": ["30% × 360 = 108°."],"errorSignals": ["ERR_PIE_DEGREES"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q16","skill": "L9.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "**Line graph** of weekly cellphone use (hours): 18, 22, 20, 25, 30, 28, 32."},"question": "Trend?","answerMode": "multiChoice","options": ["Increasing", "Decreasing", "No trend", "Cyclic"],"expectedAnswer": "Increasing","workingSteps": ["Generally rising overall."],"errorSignals": ["ERR_CHART_READ"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q17","skill": "L9.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Same series."},"question": "Range of values?","answerMode": "numeric","expectedAnswer": 14,"tolerance": 1,"workingSteps": ["32 − 18 = 14."],"errorSignals": ["ERR_RANGE"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q18","skill": "L9.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Histogram total 100 learners. 60-69 band = 25."},"question": "% in band?","answerMode": "numeric","expectedAnswer": 25,"tolerance": 1,"unit": "%","workingSteps": ["25 ÷ 100 × 100 = 25%."],"errorSignals": ["ERR_PERCENT_BASE_INVERTED"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q19","skill": "L9.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "**Pie chart of provinces in SA by share of population** (illustrative): GP 26%, KZN 19%, EC 12%, WC 12%, Other 31%."},"question": "Largest province?","answerMode": "multiChoice","options": ["GP", "KZN", "EC", "WC"],"expectedAnswer": "GP","workingSteps": ["GP 26% > KZN 19%."],"errorSignals": ["ERR_CHART_READ"],"passThreshold": 0.85},
    {"id": "L9.T4.A1.q20","skill": "L9.T4.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Same pie."},"question": "GP's slice in degrees?","answerMode": "numeric","expectedAnswer": 93.6,"tolerance": 2,"unit": "°","workingSteps": ["26% × 360 = 93,6°."],"errorSignals": ["ERR_PIE_DEGREES"],"passThreshold": 0.85}
