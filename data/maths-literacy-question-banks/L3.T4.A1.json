      "question": "Calculate the selling price.",
      "answerMode": "numeric",
      "expectedAnswer": 15,
      "tolerance": 0.5,
      "unit": "R",
      "workingSteps": ["Selling = R10 × 1,50 = R15."],
      "errorSignals": ["ERR_MARKUP_FORMULA"],
      "passThreshold": 0.85
