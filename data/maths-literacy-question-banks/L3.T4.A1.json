      "caps_level": 1,
      "source": "fresh",
      "stimulus": {"inline": "Cost price = total cost per item. A baker spends R6 on flour and R4 on other ingredients per loaf."},
      "question": "What is the cost price per loaf?",
      "answerMode": "numeric",
      "expectedAnswer": 10,
      "tolerance": 0.5,
      "unit": "R",
      "workingSteps": ["R6 + R4 = R10 cost per loaf."],
      "errorSignals": ["ERR_COST_PRICE_SUM"],
