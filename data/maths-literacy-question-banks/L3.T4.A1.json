  "_error_signal_vocabulary": {
    "ERR_COST_PRICE_SUM": "Misses a component when summing cost-price items.",
    "ERR_MARKUP_FORMULA": "Misapplies the markup formula (e.g. adds % to cost instead of multiplying by 1+r).",
    "ERR_MARKUP_BASE": "Uses selling price as the base for markup % instead of cost price.",
    "ERR_MARKUP_REVERSE": "Subtracts markup % from selling instead of dividing by (1 + r/100) to recover cost.",
    "ERR_MARGIN_VS_MARKUP": "Treats markup % and margin % as identical (they use different bases).",
    "ERR_PERCENT_BASE_INVERTED": "Uses the wrong base when finding % markup.",
    "ERR_PERCENT_REVERSE_NAIVE": "Naively subtracts a % when reversing markup.",
    "ERR_VAT_RATE": "Uses the wrong VAT rate."
  }
