  "items": [
    {"id": "L7.T1.A2.q01","skill": "L7.T1.A2","caps_level": 1,"source": "fresh","stimulus": {"inline": "BMI formula: mass (kg) ÷ height² (m)."},"question": "Mass 60 kg, height 1,70 m. Calculate BMI to 1 dp.","answerMode": "numeric","expectedAnswer": 20.8,"tolerance": 0.3,"unit": "kg/m²","workingSteps": ["1,70² = 2,89. BMI = 60 ÷ 2,89 ≈ 20,76 → 20,8."],"errorSignals": ["ERR_BMI_FORMULA","ERR_SQUARE_VS_DOUBLE"],"passThreshold": 0.85},
