    {"id": "L7.T1.A2.q05","skill": "L7.T1.A2","caps_level": 1,"source": "fresh","stimulus": {"inline": "Same categories."},"question": "BMI 32 — category?","answerMode": "multiChoice","options": ["Underweight", "Normal", "Overweight", "Obese"],"expectedAnswer": "Obese","workingSteps": ["32 ≥ 30 → obese."],"errorSignals": ["ERR_BMI_CATEGORY"],"passThreshold": 0.85},
