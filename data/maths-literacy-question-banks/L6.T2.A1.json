  "notes": "20-item bank. CAPS mix: 5 L1 / 8 L2 / 7 L3. Read to nearest mm; account for zero offset; apply lengths to carpeting/fencing/sizing.",
  "items": [
    {"id": "L6.T2.A1.q01","skill": "L6.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "A ruler reads to the nearest mm. A pencil starts at 0 and ends at the 145 mm mark."},"question": "Length in mm?","answerMode": "numeric","expectedAnswer": 145,"tolerance": 1,"unit": "mm","workingSteps": ["End − start = 145 − 0 = 145 mm."],"errorSignals": ["ERR_MEASURE_ZERO_OFFSET"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q02","skill": "L6.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "A ruler shows a chocolate bar from the 20 mm mark to the 105 mm mark (zero offset)."},"question": "Length in mm?","answerMode": "numeric","expectedAnswer": 85,"tolerance": 1,"unit": "mm","workingSteps": ["105 − 20 = 85 mm."],"errorSignals": ["ERR_MEASURE_ZERO_OFFSET"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q03","skill": "L6.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Best instrument for a kitchen tile (~10 cm × 10 cm)."},"question": "Which instrument is most appropriate?","answerMode": "multiChoice","options": ["A 30 cm ruler", "A car odometer", "A trundle wheel", "A digital weighing scale"],"expectedAnswer": "A 30 cm ruler","workingSteps": ["Tile fits on a ruler comfortably; ruler is the right precision."],"errorSignals": ["ERR_INSTRUMENT_PICK"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q04","skill": "L6.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "Best instrument for the height of a building."},"question": "Which instrument is most appropriate?","answerMode": "multiChoice","options": ["A ruler", "A measuring tape (~10 m)", "A laser distance meter", "A bathroom scale"],"expectedAnswer": "A laser distance meter","workingSteps": ["Large distances need a meter that can reach high features."],"errorSignals": ["ERR_INSTRUMENT_PICK"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q05","skill": "L6.T2.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "A ruler reading. Pencil starts at 5 mm and ends at 132 mm."},"question": "Length?","answerMode": "numeric","expectedAnswer": 127,"tolerance": 1,"unit": "mm","workingSteps": ["132 − 5 = 127 mm."],"errorSignals": ["ERR_MEASURE_ZERO_OFFSET"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q06","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "A rectangular room is 4,2 m × 3,5 m. Carpet sold in m². Round up to nearest whole m²."},"question": "How many m² of carpet needed?","answerMode": "numeric","expectedAnswer": 15,"tolerance": 0.5,"unit": "m²","workingSteps": ["Area = 4,2 × 3,5 = 14,7 m². Round up: 15 m²."],"errorSignals": ["ERR_ROUND_DIRECTION_CONTEXT"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q07","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Fencing a rectangular garden 12 m × 8 m. Calculate perimeter."},"question": "Perimeter in m?","answerMode": "numeric","expectedAnswer": 40,"tolerance": 0.5,"unit": "m","workingSteps": ["P = 2(L+B) = 2(12+8) = 40 m."],"errorSignals": ["ERR_BRACKET_MISSING_FORMULA"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q08","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Length of skirting board for a 5 m × 4 m room."},"question": "Calculate the perimeter.","answerMode": "numeric","expectedAnswer": 18,"tolerance": 0.5,"unit": "m","workingSteps": ["P = 2(5+4) = 18 m."],"errorSignals": ["ERR_BRACKET_MISSING_FORMULA"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q09","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "A bookshelf width 850 mm; book widths 32 mm each."},"question": "How many books fit?","answerMode": "numeric","expectedAnswer": 26,"tolerance": 1,"unit": "books","workingSteps": ["850 ÷ 32 = 26,56. Whole books only: 26."],"errorSignals": ["ERR_ROUND_DIRECTION_CONTEXT"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q10","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Carpet roll 4 m wide. Room is 6 m long, 3,5 m wide."},"question": "Length of carpet needed (running m at 4 m wide)?","answerMode": "numeric","expectedAnswer": 6,"tolerance": 0.5,"unit": "m","workingSteps": ["Roll covers up to 4 m wide; room is 3,5 m so one width is enough. Need 6 m running length."],"errorSignals": ["ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q11","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Door height 2,1 m. Bookshelf height 1,85 m."},"question": "Does the bookshelf fit under the door (yes/no), and by how many cm?","answerMode": "multiField","fields": [{"label": "Fits? (yes/no)", "expectedAnswer": "yes"}, {"label": "Clearance (cm)", "expectedAnswer": 25, "tolerance": 1}],"workingSteps": ["2,1 m − 1,85 m = 0,25 m = 25 cm clearance."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q12","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Diningroom rug 3 m × 2 m on a wood floor."},"question": "Area of the rug?","answerMode": "numeric","expectedAnswer": 6,"tolerance": 0.1,"unit": "m²","workingSteps": ["Area = 3 × 2 = 6 m²."],"errorSignals": ["ERR_AREA_FORMULA"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q13","skill": "L6.T2.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Pole length 1 800 mm. Want it cut into 4 equal pieces."},"question": "Length per piece (in mm)?","answerMode": "numeric","expectedAnswer": 450,"tolerance": 1,"unit": "mm","workingSteps": ["1 800 ÷ 4 = 450 mm."],"errorSignals": ["ERR_DIVISION_BASIC"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q14","skill": "L6.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Fence around a rectangular field 25 m × 18 m. Each panel is 2,5 m long. Account for 1 gate that replaces one panel."},"question": "How many panels are required (including the gate)?","answerMode": "numeric","expectedAnswer": 35,"tolerance": 1,"unit": "panels","workingSteps": ["Perimeter = 2(25+18) = 86 m.","Panels = 86 ÷ 2,5 = 34,4 → round up to 35 panels (one is replaced by a gate)."],"errorSignals": ["ERR_ROUND_DIRECTION_CONTEXT","ERR_BRACKET_MISSING_FORMULA"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q15","skill": "L6.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Tile a 4 m × 3 m floor with 30 cm × 30 cm tiles."},"question": "How many tiles needed?","answerMode": "numeric","expectedAnswer": 134,"tolerance": 5,"unit": "tiles","workingSteps": ["Floor area = 12 m² = 120 000 cm².","Tile area = 900 cm².","Tiles = 120 000 ÷ 900 ≈ 133,3 → round up to 134.","(Often round up to allow waste/cutting.)"],"errorSignals": ["ERR_AREA_FORMULA","ERR_UNIT_CONVERSION_DIRECTION","ERR_ROUND_DIRECTION_CONTEXT"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q16","skill": "L6.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "A driveway 5,5 m × 3,2 m to be paved with bricks 200 mm × 100 mm."},"question": "How many bricks needed (ignore waste)?","answerMode": "numeric","expectedAnswer": 880,"tolerance": 10,"unit": "bricks","workingSteps": ["Driveway area = 5,5 × 3,2 = 17,6 m² = 176 000 cm² = 17 600 000 mm².","Brick area = 200 × 100 = 20 000 mm².","17 600 000 ÷ 20 000 = 880."],"errorSignals": ["ERR_AREA_FORMULA","ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q17","skill": "L6.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Cut 12 dresses from fabric, each needing 2,4 m. Fabric sold in whole metres."},"question": "Metres needed?","answerMode": "numeric","expectedAnswer": 29,"tolerance": 1,"unit": "m","workingSteps": ["12 × 2,4 = 28,8 m → round up to 29 m."],"errorSignals": ["ERR_ROUND_DIRECTION_CONTEXT"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q18","skill": "L6.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Plank length 3,6 m. Cut into 0,4 m pieces."},"question": "How many pieces?","answerMode": "numeric","expectedAnswer": 9,"tolerance": 0.5,"unit": "pieces","workingSteps": ["3,6 ÷ 0,4 = 9."],"errorSignals": ["ERR_DECIMAL_PLACEMENT_QUOTIENT"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q19","skill": "L6.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Make a 5 m × 4 m vegetable garden bed with 2 m wide netting around it."},"question": "Length of netting needed (perimeter only)?","answerMode": "numeric","expectedAnswer": 18,"tolerance": 0.5,"unit": "m","workingSteps": ["P = 2(5+4) = 18 m."],"errorSignals": ["ERR_BRACKET_MISSING_FORMULA"],"passThreshold": 0.85},
    {"id": "L6.T2.A1.q20","skill": "L6.T2.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Mat width 1,8 m; want to lay it across a 2,5 m floor. Decide if it fits."},"question": "Does the mat fit fully across the 2,5 m floor?","answerMode": "multiChoice","options": ["Yes — with 0,7 m to spare", "No — it overhangs by 0,7 m", "Exactly fits", "Cannot tell"],"expectedAnswer": "Yes — with 0,7 m to spare","workingSteps": ["2,5 − 1,8 = 0,7 m gap remaining."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION"],"passThreshold": 0.85}
