    {"id": "L7.T3.A2.q20","skill": "L7.T3.A2","caps_level": 4,"source": "fresh","stimulus": {"inline": "Paving estimate. Driveway 8×4 m. Two paver options: cost R65/paver, each covers 0,04 m². Or precast slabs R380 each covering 0,5 m²."},"question": "Which option is cheaper, and by how much?","answerMode": "multiField","fields": [{"label": "Cheaper option", "expectedAnswer": "slabs"}, {"label": "Saving (R)", "expectedAnswer": 27680, "tolerance": 500}],"workingSteps": ["Area = 32 m².","Pavers: 32 ÷ 0,04 = 800 pavers × R65 = R52 000.","Slabs: 32 ÷ 0,5 = 64 slabs × R380 = R24 320.","Saving with slabs: R52 000 − R24 320 = R27 680."],"errorSignals": ["ERR_RATE_USE_OPERATION","ERR_AREA_FORMULA"],"passThreshold": 0.85}
