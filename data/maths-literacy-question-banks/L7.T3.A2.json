    {"id": "L7.T3.A2.q10","skill": "L7.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Garden 12 m × 8 m. Compost 25 L per m³ at 5 cm deep (so 0,05 m³/m²). Cost R45/L."},"question": "Cost of compost?","answerMode": "numeric","expectedAnswer": 5400,"tolerance": 50,"unit": "R","workingSteps": ["Garden area = 12 × 8 = 96 m².","Volume of compost at 5 cm depth: 96 × 0,05 = 4,8 m³.","Litres needed at 25 L per m³: 4,8 × 25 = 120 L.","Cost = 120 × R45 = R5 400."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
