    {"id": "L7.T3.A2.q16","skill": "L7.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Lawn 15×10 m. Fertiliser R12/m²."},"question": "Cost?","answerMode": "numeric","expectedAnswer": 1800,"tolerance": 10,"unit": "R","workingSteps": ["150 × R12 = R1 800."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L7.T3.A2.q17","skill": "L7.T3.A2","caps_level": 4,"source": "fresh","stimulus": {"inline": "Wall 6 × 3 m with 2 windows 1×1 m each. Paint 8 m²/L; sold 1 L (R85) and 5 L (R380) tins. Two coats. Pick cheapest combination."},"question": "Cheapest cost?","answerMode": "numeric","expectedAnswer": 340,"tolerance": 30,"unit": "R","workingSteps": ["Net wall area: 6 × 3 − 2 × (1 × 1) = 18 − 2 = 16 m².","Two coats: 16 × 2 = 32 m².","Paint needed: 32 ÷ 8 = 4 L.","Compare options: 4 × 1 L tins = 4 × R85 = R340; 1 × 5 L tin = R380.","Cheapest combination = R340 (four 1 L tins)."],"errorSignals": ["ERR_ROUND_DIRECTION_CONTEXT","ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L7.T3.A2.q18","skill": "L7.T3.A2","caps_level": 4,"source": "fresh","stimulus": {"inline": "Tile 30×30 cm sold in boxes of 11 (R450/box). Floor 5×4 m, 10% waste."},"question": "Boxes and cost?","answerMode": "multiField","fields": [{"label": "Boxes", "expectedAnswer": 23, "tolerance": 1}, {"label": "Cost (R)", "expectedAnswer": 10350, "tolerance": 200}],"workingSteps": ["Floor area = 20 m². Tiles: 20 ÷ 0,09 ≈ 223 + 10% = ~245 tiles. Boxes: 245 ÷ 11 = 22,3 → 23 boxes. Cost: 23 × R450 = R10 350."],"errorSignals": ["ERR_UNIT_CONVERSION_DIRECTION","ERR_ROUND_DIRECTION_CONTEXT"],"passThreshold": 0.85},
