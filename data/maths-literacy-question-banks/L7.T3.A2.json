    {"id": "L7.T3.A2.q13","skill": "L7.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Tile shop sells 30×30 cm tiles in boxes of 12 tiles. Floor 5×4 m needs 222 tiles (with waste allowance)."},"question": "Boxes?","answerMode": "numeric","expectedAnswer": 19,"tolerance": 1,"unit": "boxes","workingSteps": ["222 ÷ 12 = 18,5 → 19 boxes (round up)."],"errorSignals": ["ERR_ROUND_DIRECTION_CONTEXT"],"passThreshold": 0.85},
    {"id": "L7.T3.A2.q14","skill": "L7.T3.A2","caps_level": 3,"source": "fresh","stimulus": {"inline": "Paving R450/m². Driveway 4×6 m + 1×4 m extension."},"question": "Total cost?","answerMode": "numeric","expectedAnswer": 12600,"tolerance": 30,"unit": "R","workingSteps": ["Area = 24 + 4 = 28 m². Cost = 28 × R450 = R12 600."],"errorSignals": ["ERR_COMPOSITE_AREA","ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
