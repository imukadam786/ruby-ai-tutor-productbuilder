    {"id": "L6.T3.A1.q01","skill": "L6.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "24-h to 12-h: subtract 12 for afternoon times."},"question": "Convert 14:30 to 12-hour time.","answerMode": "multiChoice","options": ["2:30 am", "2:30 pm", "4:30 pm", "14:30 pm"],"expectedAnswer": "2:30 pm","workingSteps": ["14:30 − 12:00 = 2:30 pm."],"errorSignals": ["ERR_24H_12H_CONVERSION"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q02","skill": "L6.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "12-h to 24-h."},"question": "Convert 7:45 pm to 24-hour time.","answerMode": "multiChoice","options": ["07:45", "17:45", "19:45", "20:45"],"expectedAnswer": "19:45","workingSteps": ["7:45 pm + 12 = 19:45."],"errorSignals": ["ERR_24H_12H_CONVERSION"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q03","skill": "L6.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "00:00 = midnight, 12:00 = noon."},"question": "What does 00:30 mean?","answerMode": "multiChoice","options": ["12:30 am (half past midnight)", "12:30 pm", "Half past midday", "Cannot exist"],"expectedAnswer": "12:30 am (half past midnight)","workingSteps": ["00:30 is 30 minutes past midnight = 12:30 am."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q04","skill": "L6.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "From 09:00 to 11:30 — elapsed time."},"question": "Calculate elapsed time.","answerMode": "multiChoice","options": ["2 h 30 min", "1 h 30 min", "2 h 0 min", "3 h 30 min"],"expectedAnswer": "2 h 30 min","workingSteps": ["11:30 − 09:00 = 2 h 30 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q05","skill": "L6.T3.A1","caps_level": 1,"source": "fresh","stimulus": {"inline": "From 08:15 to 09:50."},"question": "Calculate elapsed time in minutes.","answerMode": "numeric","expectedAnswer": 95,"tolerance": 1,"unit": "minutes","workingSteps": ["08:15 → 09:15 = 60 min. 09:15 → 09:50 = 35 min. Total: 95 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q06","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Train leaves 22:45 and arrives 02:15 (next day)."},"question": "Calculate journey duration in hours and minutes.","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 3, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 30, "tolerance": 1}],"workingSteps": ["22:45 to 24:00 = 1 h 15 min. 00:00 to 02:15 = 2 h 15 min. Total = 3 h 30 min."],"errorSignals": ["ERR_TIME_DURATION_MIDNIGHT"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q07","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "A film starts at 19:50 and ends at 22:35."},"question": "Calculate duration in minutes.","answerMode": "numeric","expectedAnswer": 165,"tolerance": 1,"unit": "minutes","workingSteps": ["19:50 → 21:50 = 120 min. 21:50 → 22:35 = 45 min. Total: 165 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q08","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "What does 23:59 + 0:02 give?"},"question": "Time after adding 2 minutes to 23:59.","answerMode": "multiChoice","options": ["24:01", "00:01", "23:01", "01:00"],"expectedAnswer": "00:01","workingSteps": ["23:59 + 1 min = 00:00. + 1 more min = 00:01 (next day)."],"errorSignals": ["ERR_TIME_DURATION_MIDNIGHT"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q09","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "A learner studies 1 h 45 min/day for 5 days."},"question": "Calculate total study time in hours and minutes.","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 8, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 45, "tolerance": 1}],"workingSteps": ["Per day = 105 min. 5 days = 525 min = 8 h 45 min."],"errorSignals": ["ERR_TIME_HM_TO_MIN"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q10","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "From 15:00 → 18:45."},"question": "Calculate duration in hours and minutes.","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 3, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 45, "tolerance": 1}],"workingSteps": ["18:45 − 15:00 = 3 h 45 min."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q11","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Add 2 h 50 min to 09:30."},"question": "What time is it?","answerMode": "multiChoice","options": ["11:20", "12:20", "12:80", "11:80"],"expectedAnswer": "12:20","workingSteps": ["09:30 + 2 h = 11:30. + 50 min = 12:20."],"errorSignals": ["ERR_TIME_HM_TO_MIN"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q12","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Convert 2,5 hours to hours and minutes."},"question": "Convert 2,5 h.","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 2, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 30, "tolerance": 1}],"workingSteps": ["0,5 h = 30 min. So 2 h 30 min."],"errorSignals": ["ERR_DECIMAL_TO_TIME"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q13","skill": "L6.T3.A1","caps_level": 2,"source": "fresh","stimulus": {"inline": "Convert 75 minutes to h:min."},"question": "Convert 75 min.","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 1, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 15, "tolerance": 1}],"workingSteps": ["75 ÷ 60 = 1 h, remainder 15 min."],"errorSignals": ["ERR_TIME_HM_TO_MIN"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q14","skill": "L6.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Flight departs Cape Town 23:30 and arrives Dubai 09:15 (same time zone for simplicity)."},"question": "Calculate flight duration in hours and minutes.","answerMode": "multiField","fields": [{"label": "Hours", "expectedAnswer": 9, "tolerance": 0.1}, {"label": "Minutes", "expectedAnswer": 45, "tolerance": 1}],"workingSteps": ["23:30 → 24:00 = 30 min. 00:00 → 09:15 = 9 h 15 min. Total: 9 h 45 min."],"errorSignals": ["ERR_TIME_DURATION_MIDNIGHT"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q15","skill": "L6.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "A learner walks daily 35 min each way to school for 5 school days."},"question": "Total walking minutes per week?","answerMode": "numeric","expectedAnswer": 350,"tolerance": 5,"unit": "minutes","workingSteps": ["35 × 2 × 5 = 350 min."],"errorSignals": ["ERR_RATE_USE_OPERATION"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q16","skill": "L6.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Football match starts 19:00, full time 80 min, half-time 15 min."},"question": "Time match ends?","answerMode": "multiChoice","options": ["20:35", "20:30", "20:20", "20:45"],"expectedAnswer": "20:35","workingSteps": ["19:00 + 80 min + 15 min = 19:00 + 95 min = 20:35."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q17","skill": "L6.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Course runs 09:00–16:00 daily with 1h lunch. Convert to working hours per day."},"question": "Calculate working hours per day.","answerMode": "numeric","expectedAnswer": 6,"tolerance": 0.1,"unit": "hours","workingSteps": ["Total clock = 7 h. Minus 1 h lunch = 6 h."],"errorSignals": ["ERR_24H_TIME_CALC"],"passThreshold": 0.85},
    {"id": "L6.T3.A1.q18","skill": "L6.T3.A1","caps_level": 3,"source": "fresh","stimulus": {"inline": "Add 1 h 45 min to 22:15."},"question": "What time?","answerMode": "multiChoice","options": ["00:00", "23:60", "00:00 (midnight)", "00:00 (next day)"],"expectedAnswer": "00:00 (next day)","workingSteps": ["22:15 + 1 h = 23:15. + 45 min = 24:00 = 00:00 (next day)."],"errorSignals": ["ERR_TIME_DURATION_MIDNIGHT"],"passThreshold": 0.85},
